{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/attestation.result.schema.json",
  "title": "Attestation Result Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "attestation_result_id",
    "worker_id",
    "deployment_id",
    "appraisal_policy_id",
    "reference_value_refs",
    "endorsement_refs",
    "attestation_evidence_refs",
    "appraisal_result",
    "trust_effect",
    "reason_codes",
    "evidence_refs",
    "policy_version",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "attestation.result"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "security_reviewer",
            "field_it_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "attestation_result_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "appraisal_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_value_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "endorsement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "attestation_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "appraisal_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "expired",
        "blocked_mvp"
      ]
    },
    "trust_effect": {
      "type": "string",
      "enum": [
        "trusted_metadata_only",
        "degraded",
        "quarantine_required",
        "revoked",
        "blocked_mvp"
      ]
    },
    "lineage_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "revocation_propagation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "trust_effect_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "appraisal_result": {
            "const": "pass"
          }
        }
      },
      "then": {
        "required": [
          "reference_value_refs",
          "endorsement_refs",
          "attestation_evidence_refs",
          "evidence_refs",
          "expires_at"
        ],
        "properties": {
          "reference_value_refs": {
            "minItems": 1
          },
          "endorsement_refs": {
            "minItems": 1
          },
          "attestation_evidence_refs": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "trust_effect": {
            "const": "trusted_metadata_only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "appraisal_result": {
            "const": "fail"
          }
        }
      },
      "then": {
        "properties": {
          "trust_effect": {
            "not": {
              "const": "trusted_metadata_only"
            }
          },
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "appraisal_failed"
            }
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "appraisal_result": {
            "const": "inconclusive"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "appraisal_inconclusive"
            }
          },
          "evidence_refs": {
            "minItems": 1
          },
          "trust_effect": {
            "enum": [
              "degraded",
              "quarantine_required",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "appraisal_result": {
            "const": "expired"
          }
        }
      },
      "then": {
        "required": [
          "expires_at"
        ],
        "properties": {
          "trust_effect": {
            "not": {
              "const": "trusted_metadata_only"
            }
          },
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "attestation_result_expired"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "appraisal_result": {
            "const": "blocked_mvp"
          }
        }
      },
      "then": {
        "properties": {
          "trust_effect": {
            "not": {
              "const": "trusted_metadata_only"
            }
          }
        }
      }
    }
  ]
}
