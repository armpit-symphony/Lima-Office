{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/worker.heartbeat.schema.json",
  "title": "Worker Heartbeat Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "heartbeat_id",
    "worker_id",
    "producer",
    "heartbeat_sequence",
    "boot_id",
    "reported_at",
    "supervisor_received_at",
    "heartbeat_due_at",
    "heartbeat_age_seconds",
    "worker_process_uptime_seconds",
    "lifecycle_state",
    "health_state",
    "data_classification",
    "risk_tier",
    "current_task_count",
    "queue_depth",
    "capability_manifest_version",
    "capability_manifest_hash_ref",
    "tool_pack_scope_version",
    "local_model_status",
    "update_version",
    "rollback_version",
    "update_status",
    "evidence_writer_status",
    "evidence_spool_depth",
    "last_evidence_write_at",
    "last_evidence_error_code",
    "resource_posture",
    "network_posture",
    "network_reachability",
    "guardian_reachability",
    "missed_heartbeat_count",
    "policy_version",
    "guardian_decision_id",
    "evidence_artifact_id",
    "evidence_artifact_ids"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "worker.heartbeat"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "heartbeat_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "worker",
            "supervisor"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "heartbeat_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "boot_id": {
      "type": "string",
      "minLength": 1
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "supervisor_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeat_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeat_age_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "worker_process_uptime_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "pending_registration",
        "registered",
        "healthy",
        "degraded",
        "offline",
        "quarantined",
        "revoked"
      ]
    },
    "health_state": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "offline",
        "quarantined",
        "revoked"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "current_task_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "queue_depth": {
      "type": "integer",
      "minimum": 0
    },
    "capability_manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "capability_manifest_hash_ref": {
      "type": "string",
      "minLength": 1
    },
    "tool_pack_scope_version": {
      "type": "string",
      "minLength": 1
    },
    "local_model_status": {
      "type": "string",
      "enum": [
        "not_available",
        "available",
        "degraded"
      ]
    },
    "update_version": {
      "type": "string",
      "minLength": 1
    },
    "rollback_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "update_status": {
      "type": "string",
      "enum": [
        "current",
        "update_available",
        "update_pending_approval",
        "update_failed",
        "rollback_needed"
      ]
    },
    "evidence_writer_status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "failed"
      ]
    },
    "evidence_spool_depth": {
      "type": "integer",
      "minimum": 0
    },
    "last_evidence_write_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_evidence_error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none",
        "ledger_unavailable",
        "integrity_check_failed",
        "permission_denied",
        "storage_full",
        null
      ]
    },
    "resource_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_percent",
        "memory_percent",
        "disk_free_percent"
      ],
      "properties": {
        "cpu_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "memory_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "disk_free_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "network_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisor_channel",
        "internet_required",
        "clock_skew_ms"
      ],
      "properties": {
        "supervisor_channel": {
          "type": "string",
          "enum": [
            "authenticated",
            "degraded",
            "unreachable"
          ]
        },
        "internet_required": {
          "type": "boolean"
        },
        "clock_skew_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "network_reachability": {
      "type": "string",
      "enum": [
        "supervisor_only",
        "local_network_ok",
        "degraded",
        "unreachable"
      ]
    },
    "guardian_reachability": {
      "type": "string",
      "enum": [
        "reachable",
        "degraded",
        "unreachable"
      ]
    },
    "missed_heartbeat_count": {
      "type": "integer",
      "minimum": 0
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "last_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_task_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "accepted",
        "in_progress",
        "needs_approval",
        "draft_ready",
        "blocked",
        "failed",
        "completed_mock",
        "quarantined",
        null
      ]
    },
    "quarantine_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_failure_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "incident_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operator_action_required": {
      "type": "boolean"
    },
    "runbook_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_writer_status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "evidence_failure_id",
          "runbook_ref"
        ],
        "properties": {
          "health_state": {
            "enum": [
              "degraded",
              "quarantined"
            ]
          },
          "risk_tier": {
            "enum": [
              "high",
              "blocked"
            ]
          },
          "last_evidence_error_code": {
            "not": {
              "enum": [
                "none",
                null
              ]
            }
          },
          "operator_action_required": {
            "const": true
          },
          "evidence_failure_id": {
            "type": "string",
            "minLength": 1
          },
          "runbook_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_writer_status": {
            "const": "degraded"
          }
        }
      },
      "then": {
        "properties": {
          "health_state": {
            "enum": [
              "degraded",
              "quarantined"
            ]
          },
          "operator_action_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "health_state": {
            "const": "healthy"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_writer_status": {
            "const": "healthy"
          },
          "guardian_reachability": {
            "const": "reachable"
          },
          "missed_heartbeat_count": {
            "const": 0
          }
        }
      }
    }
  ]
}
