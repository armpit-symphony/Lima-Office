{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/attestation.reference_value.schema.json",
  "title": "Attestation Reference Value Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "reference_value_id",
    "reference_value_type",
    "reference_status",
    "value_hash",
    "hash_algorithm",
    "applies_to_worker_roles",
    "applies_to_worker_ids",
    "applies_to_deployment_ids",
    "approved_by_ref",
    "policy_refs",
    "authority_refs",
    "evidence_refs",
    "reason_codes",
    "policy_version",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "attestation.reference_value"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "operator_console",
            "field_it_reviewer",
            "security_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reference_value_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_value_type": {
      "type": "string",
      "enum": [
        "os_image_hash",
        "arc_runtime_hash",
        "policy_bundle_hash",
        "model_bundle_hash",
        "config_hash",
        "update_artifact_hash",
        "rollback_target_hash"
      ]
    },
    "reference_status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "active",
        "deprecated",
        "revoked",
        "blocked_mvp"
      ]
    },
    "value_hash": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "enum": [
        "sha256",
        "sha384",
        "sha512"
      ]
    },
    "applies_to_worker_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applies_to_worker_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applies_to_deployment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approved_by_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reference_status": {
            "const": "active"
          }
        }
      },
      "then": {
        "required": [
          "approved_by_ref",
          "approved_at",
          "policy_refs",
          "evidence_refs"
        ],
        "properties": {
          "approved_by_ref": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "policy_refs": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reference_status": {
            "const": "revoked"
          }
        }
      },
      "then": {
        "required": [
          "revoked_at",
          "reason_codes"
        ],
        "properties": {
          "revoked_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "reference_value_revoked"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reference_status": {
            "const": "deprecated"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reference_status": {
            "const": "blocked_mvp"
          }
        }
      },
      "then": {
        "properties": {
          "approved_at": {
            "type": "null"
          },
          "approved_by_ref": {
            "type": "null"
          }
        }
      }
    }
  ]
}
