{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/operator.worker_inventory.response.schema.json",
  "title": "Authenticated Operator Worker Inventory Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "request_id",
    "actor_id",
    "status",
    "classification_authority",
    "worker_count",
    "workers",
    "evidence_refs",
    "reason_codes",
    "runtime_authority_blocked",
    "executable",
    "execution_allowed",
    "side_effects_allowed"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "operator.worker_inventory.response"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "taxonomy_version": {"type": "string", "const": "taxonomy-recon-v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "produced_at"],
      "properties": {
        "component": {"type": "string", "const": "supervisor"},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy_version": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["healthy", "degraded_read_only", "denied", "unavailable"]},
    "classification_authority": {"type": "string", "const": "supervisor_server_derived"},
    "worker_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "workers": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "worker_id",
          "role",
          "capabilities",
          "state",
          "authenticated",
          "eligible",
          "worker_version",
          "last_heartbeat_at",
          "control_plane_status",
          "guardian_decision_id",
          "lima_decision_id",
          "lima_status",
          "assignment_status",
          "evidence_refs",
          "reason_codes",
          "runtime_authority_blocked",
          "executable",
          "execution_allowed",
          "side_effects_allowed"
        ],
        "properties": {
          "worker_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "state": {"type": "string", "enum": ["registered", "healthy", "degraded", "offline", "quarantined", "revoked", "replaced"]},
          "authenticated": {"type": "boolean"},
          "eligible": {"type": "boolean"},
          "worker_version": {"type": ["string", "null"]},
          "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
          "control_plane_status": {"type": "string", "enum": ["acknowledged", "rejected", "blocked", "denied", "confirm_required", "privileged_required", "unavailable"]},
          "guardian_decision_id": {"type": ["string", "null"]},
          "lima_decision_id": {"type": ["string", "null"]},
          "lima_status": {"type": ["string", "null"], "enum": ["allowed_dry_run", "confirm_required", "privileged_required", "denied", null]},
          "assignment_status": {"type": ["string", "null"], "enum": ["acknowledged", "rejected", null]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "runtime_authority_blocked": {"type": "boolean", "const": true},
          "executable": {"type": "boolean", "const": false},
          "execution_allowed": {"type": "boolean", "const": false},
          "side_effects_allowed": {"type": "boolean", "const": false}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "runtime_authority_blocked": {"type": "boolean", "const": true},
    "executable": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false},
    "side_effects_allowed": {"type": "boolean", "const": false}
  }
}
