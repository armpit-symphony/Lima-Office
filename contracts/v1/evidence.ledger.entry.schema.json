{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/evidence.ledger.entry.schema.json",
  "title": "Evidence Ledger Entry Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "ledger_entry_id",
    "evidence_id",
    "parent_entry_ids",
    "entry_type",
    "content_hash",
    "hash_algorithm",
    "previous_hash",
    "entry_hash",
    "chain_position",
    "redaction_profile_ref",
    "retention_policy_refs",
    "export_manifest_refs",
    "raw_content_included",
    "secret_material_included",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "evidence.ledger.entry"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "guardian",
            "operator_console",
            "worker"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "ledger_entry_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_entry_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "pre_action",
        "post_action",
        "denial",
        "replay_denial",
        "export_manifest",
        "delete_review",
        "rollback"
      ]
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "enum": [
        "sha256",
        "sha512"
      ]
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_hash": {
      "type": "string",
      "minLength": 1
    },
    "chain_position": {
      "type": "integer",
      "minimum": 1
    },
    "redaction_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "retention_policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "export_manifest_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "raw_content_included": {
      "type": "boolean",
      "const": false
    },
    "secret_material_included": {
      "type": "boolean",
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chain_position": {
            "minimum": 2
          }
        },
        "required": [
          "chain_position"
        ]
      },
      "then": {
        "properties": {
          "previous_hash": {
            "type": "string",
            "minLength": 1
          },
          "parent_entry_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entry_type": {
            "const": "export_manifest"
          }
        },
        "required": [
          "entry_type"
        ]
      },
      "then": {
        "properties": {
          "export_manifest_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entry_type": {
            "enum": [
              "replay_denial",
              "rollback"
            ]
          }
        },
        "required": [
          "entry_type"
        ]
      },
      "then": {
        "properties": {
          "parent_entry_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
