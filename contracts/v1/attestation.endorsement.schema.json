{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/attestation.endorsement.schema.json",
  "title": "Attestation Endorsement Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "endorsement_id",
    "endorsement_type",
    "endorsement_status",
    "subject_ref",
    "issuer_ref",
    "valid_from",
    "valid_until",
    "policy_refs",
    "evidence_refs",
    "reason_codes",
    "policy_version",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "attestation.endorsement"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "field_it_reviewer",
            "security_reviewer",
            "operator_console"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "endorsement_id": {
      "type": "string",
      "minLength": 1
    },
    "endorsement_type": {
      "type": "string",
      "enum": [
        "hardware_vendor_placeholder",
        "os_vendor_placeholder",
        "sparkpit_operator_placeholder",
        "customer_admin_placeholder",
        "blocked_mvp"
      ]
    },
    "endorsement_status": {
      "type": "string",
      "enum": [
        "collected",
        "trusted_placeholder",
        "untrusted",
        "expired",
        "revoked",
        "blocked_mvp"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "issuer_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "endorsement_status": {
            "const": "trusted_placeholder"
          }
        }
      },
      "then": {
        "required": [
          "issuer_ref",
          "valid_from",
          "valid_until",
          "policy_refs",
          "evidence_refs"
        ],
        "properties": {
          "issuer_ref": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "policy_refs": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "endorsement_status": {
            "enum": [
              "revoked",
              "expired",
              "untrusted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "endorsement_type": {
            "const": "blocked_mvp"
          }
        }
      },
      "then": {
        "properties": {
          "endorsement_status": {
            "not": {
              "const": "trusted_placeholder"
            }
          }
        }
      }
    }
  ]
}
