{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/governance.audit_export.schema.json",
  "title": "Governance Audit Export Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "taxonomy_version",
    "export_request_id",
    "request_type",
    "requester_identity_ref",
    "approver_identity_ref",
    "scope",
    "record_classes",
    "redaction_profile",
    "non_exportable_classes",
    "delete_request",
    "evidence_preservation_conflict",
    "status",
    "export_review_status",
    "delete_review_status",
    "redaction_status",
    "preservation_hold_status",
    "reason_codes",
    "reconciliation_reason_codes",
    "evidence_reason_codes",
    "export_delete_conflict_codes",
    "retention_policy_refs",
    "redaction_profile_ref",
    "policy_refs",
    "conflict_evidence_refs",
    "delete_proof_refs",
    "export_manifest_refs",
    "export_package_refs",
    "guardian_decision_id",
    "evidence_refs",
    "blocked_reason",
    "created_at",
    "updated_at",
    "raw_content_included",
    "secret_material_included"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "governance.audit_export"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "operator_console",
            "supervisor",
            "security_reviewer",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "export_request_id": {
      "type": "string",
      "minLength": 1
    },
    "request_type": {
      "type": "string",
      "enum": [
        "audit_export",
        "customer_exit",
        "delete_request",
        "export_and_delete_review"
      ]
    },
    "requester_identity_ref": {
      "type": "string",
      "minLength": 1
    },
    "approver_identity_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_scope_confirmed",
        "starts_at",
        "ends_at",
        "resource_scope_refs"
      ],
      "properties": {
        "tenant_scope_confirmed": {
          "type": "boolean",
          "const": true
        },
        "starts_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ends_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resource_scope_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "record_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "task_metadata",
          "guardian_decisions",
          "approvals",
          "evidence_artifacts",
          "worker_records",
          "model_routes",
          "tool_invocations",
          "memory_access",
          "connector_records",
          "lima_it_handoff",
          "incidents",
          "governance_records"
        ]
      },
      "uniqueItems": true
    },
    "redaction_profile": {
      "type": "string",
      "enum": [
        "metadata_only",
        "operational_summary",
        "customer_safe_summary",
        "security_review",
        "export_redacted"
      ]
    },
    "non_exportable_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "credentials",
          "raw_prompts",
          "raw_model_responses",
          "raw_connector_payloads",
          "raw_tool_output",
          "raw_customer_files",
          "private_key_material",
          "out_of_scope_tenant_data"
        ]
      },
      "uniqueItems": true
    },
    "delete_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delete_requested",
        "delete_scope_ref",
        "delete_approved",
        "delete_proof_ref"
      ],
      "properties": {
        "delete_requested": {
          "type": "boolean"
        },
        "delete_scope_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "delete_approved": {
          "type": "boolean"
        },
        "delete_proof_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_preservation_conflict": {
      "type": "string",
      "enum": [
        "not_evaluated",
        "none_identified",
        "conflict_placeholder",
        "blocks_delete"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "review_required",
        "approved_placeholder",
        "denied",
        "blocked",
        "completed_mock",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "export_review_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "review_required",
        "approved",
        "denied",
        "prepared",
        "exported",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "delete_review_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "review_required",
        "approved",
        "denied",
        "conflict_detected",
        "blocked_mvp"
      ]
    },
    "redaction_status": {
      "type": "string",
      "enum": [
        "not_required",
        "required",
        "pending",
        "applied",
        "failed",
        "blocked_mvp"
      ]
    },
    "preservation_hold_status": {
      "type": "string",
      "enum": [
        "none",
        "required",
        "active",
        "conflict_with_delete",
        "released",
        "blocked_mvp"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "reconciliation_reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "export_delete_conflict_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retention_policy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "redaction_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conflict_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[A-Za-z0-9._:-]+$"
      },
      "uniqueItems": true
    },
    "delete_proof_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "export_manifest_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "export_package_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev-[A-Za-z0-9._:-]+$"
      },
      "uniqueItems": true
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_content_included": {
      "type": "boolean",
      "const": false
    },
    "secret_material_included": {
      "type": "boolean",
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "delete_review_status": {
            "const": "conflict_detected"
          }
        },
        "required": [
          "delete_review_status"
        ]
      },
      "then": {
        "properties": {
          "conflict_evidence_refs": {
            "minItems": 1
          },
          "reason_codes": {
            "minItems": 1
          },
          "export_delete_conflict_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "export_review_status": {
            "const": "exported"
          }
        },
        "required": [
          "export_review_status"
        ]
      },
      "then": {
        "properties": {
          "redaction_status": {
            "enum": [
              "applied",
              "not_required"
            ]
          },
          "export_manifest_refs": {
            "minItems": 1
          },
          "export_package_refs": {
            "minItems": 1
          },
          "status": {
            "const": "completed_mock"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delete_review_status": {
            "const": "approved"
          }
        },
        "required": [
          "delete_review_status"
        ]
      },
      "then": {
        "properties": {
          "delete_proof_refs": {
            "minItems": 1
          },
          "preservation_hold_status": {
            "enum": [
              "none",
              "released"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "preservation_hold_status": {
            "enum": [
              "active",
              "conflict_with_delete"
            ]
          }
        },
        "required": [
          "preservation_hold_status"
        ]
      },
      "then": {
        "properties": {
          "delete_review_status": {
            "enum": [
              "review_required",
              "denied",
              "conflict_detected",
              "blocked_mvp"
            ]
          },
          "status": {
            "not": {
              "const": "completed_mock"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "denied",
              "blocked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          },
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed_closed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked_mvp"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "environment": {
            "const": "blocked_mvp"
          },
          "export_review_status": {
            "not": {
              "const": "exported"
            }
          },
          "delete_review_status": {
            "not": {
              "const": "approved"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "enum": [
              "delete_request",
              "export_and_delete_review",
              "customer_exit"
            ]
          }
        },
        "required": [
          "request_type"
        ]
      },
      "then": {
        "properties": {
          "evidence_preservation_conflict": {
            "enum": [
              "none_identified",
              "conflict_placeholder",
              "blocks_delete"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "const": "unknown"
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "denied",
              "failed_closed",
              "blocked_mvp",
              "review_required"
            ]
          },
          "export_review_status": {
            "not": {
              "const": "exported"
            }
          },
          "delete_review_status": {
            "not": {
              "const": "approved"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "const": "blocked"
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "denied",
              "failed_closed",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "const": "deprecated"
          },
          "deprecated_reason_code_policy": {
            "enum": [
              "fail_closed",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "reason_code_status",
          "deprecated_reason_code_policy"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "not": {
              "const": "approved"
            }
          }
        }
      }
    }
  ]
}
