{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/connector.acceptance_score.schema.json",
  "title": "Connector Acceptance Score Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "acceptance_score_id",
    "connector_id",
    "provider_profile_id",
    "connector_readiness_id",
    "scope_review_id",
    "connector_consent_id",
    "revocation_drill_id",
    "reconciliation_id",
    "scoring_version",
    "score_status",
    "overall_score",
    "max_score",
    "dimension_scores",
    "failed_dimensions",
    "required_improvements",
    "reason_codes",
    "evidence_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "connector.acceptance_score"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "security_reviewer",
            "operator_console",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_score_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_readiness_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_review_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_consent_id": {
      "type": "string",
      "minLength": 1
    },
    "revocation_drill_id": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_id": {
      "type": "string",
      "minLength": 1
    },
    "scoring_version": {
      "type": "string",
      "minLength": 1
    },
    "score_status": {
      "type": "string",
      "enum": [
        "blocked_mvp",
        "not_ready",
        "review_required",
        "approved_for_lab",
        "degraded",
        "revoked",
        "failed_closed"
      ]
    },
    "overall_score": {
      "type": "number",
      "minimum": 0
    },
    "max_score": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "failed_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_improvements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "acceptance_score_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reconciliation_slo_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "score_status": {
            "const": "approved_for_lab"
          }
        },
        "required": [
          "score_status"
        ]
      },
      "then": {
        "properties": {
          "failed_dimensions": {
            "maxItems": 0
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "score_status": {
            "const": "revoked"
          }
        },
        "required": [
          "score_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "score_status": {
            "const": "failed_closed"
          }
        },
        "required": [
          "score_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "failed_dimensions": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "score_status": {
            "const": "degraded"
          }
        },
        "required": [
          "score_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "score_status": {
            "const": "blocked_mvp"
          }
        },
        "required": [
          "score_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "connector_acceptance_blocked_mvp"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "score_status": {
            "not": {
              "const": "approved_for_lab"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "const": "deprecated"
          },
          "deprecated_reason_code_policy": {
            "enum": [
              "fail_closed",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "reason_code_status",
          "deprecated_reason_code_policy"
        ]
      },
      "then": {
        "properties": {
          "score_status": {
            "not": {
              "const": "approved_for_lab"
            }
          }
        }
      }
    }
  ]
}
