{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/connector.slo_target.schema.json",
  "title": "Connector SLO Target Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "connector_slo_target_id",
    "slo_version",
    "connector_id",
    "provider_category",
    "owner_review_cadence_seconds_placeholder",
    "revocation_propagation_seconds_placeholder",
    "disable_switch_verification_seconds_placeholder",
    "stale_owner_escalation_seconds_placeholder",
    "reconciliation_cadence_seconds_placeholder",
    "target_status",
    "owner_ref",
    "reviewer_ref",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "updated_at",
    "reviewed_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "connector.slo_target"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "operator_console",
            "security_reviewer",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "connector_slo_target_id": {
      "type": "string",
      "minLength": 1
    },
    "slo_version": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_category": {
      "type": "string",
      "enum": [
        "email",
        "calendar",
        "file_storage",
        "ticketing",
        "crm",
        "chat",
        "phone_text",
        "browser",
        "rmm_it",
        "cloud_provider",
        "payment",
        "legal_regulated",
        "blocked_mvp"
      ]
    },
    "owner_review_cadence_seconds_placeholder": {
      "type": "integer",
      "minimum": 1
    },
    "revocation_propagation_seconds_placeholder": {
      "type": "integer",
      "minimum": 1
    },
    "disable_switch_verification_seconds_placeholder": {
      "type": "integer",
      "minimum": 1
    },
    "stale_owner_escalation_seconds_placeholder": {
      "type": "integer",
      "minimum": 1
    },
    "reconciliation_cadence_seconds_placeholder": {
      "type": "integer",
      "minimum": 1
    },
    "target_status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved_placeholder",
        "active_placeholder",
        "stale",
        "missed",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "owner_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reviewer_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "connector_defaults_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "score_threshold_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_status": {
            "const": "active_placeholder"
          }
        },
        "required": [
          "target_status"
        ]
      },
      "then": {
        "required": [
          "owner_ref",
          "reviewer_ref"
        ],
        "properties": {
          "owner_ref": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_status": {
            "enum": [
              "stale",
              "missed",
              "failed_closed"
            ]
          }
        },
        "required": [
          "target_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_category": {
            "enum": [
              "browser",
              "rmm_it",
              "cloud_provider",
              "payment",
              "legal_regulated",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "provider_category"
        ]
      },
      "then": {
        "properties": {
          "target_status": {
            "enum": [
              "blocked_mvp",
              "failed_closed"
            ]
          },
          "reason_codes": {
            "contains": {
              "const": "connector_provider_category_blocked_mvp"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "target_status": {
            "not": {
              "enum": [
                "active_placeholder",
                "approved_placeholder"
              ]
            }
          }
        }
      }
    }
  ]
}
