{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/supervisor.control_plane.request.schema.json",
  "title": "Supervisor Control-Plane Request Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "request_id",
    "actor_id",
    "actor_role",
    "action",
    "action_category",
    "classification_authority",
    "resource",
    "requested_worker_id",
    "normalized_summary",
    "request_hash",
    "payload_hash",
    "received_at"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "supervisor.control_plane.request"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "taxonomy_version": {"type": "string", "const": "taxonomy-recon-v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "produced_at"],
      "properties": {
        "component": {"type": "string", "enum": ["operator_console", "supervisor"]},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy_version": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "actor_role": {
      "type": "string",
      "enum": ["operator", "supervisor", "field_it", "security_reviewer"]
    },
    "action": {
      "type": "string",
      "enum": [
        "safe_read",
        "safe_list",
        "status",
        "external_write",
        "shell",
        "credential_access",
        "file_mutation",
        "unknown"
      ]
    },
    "action_category": {
      "type": "string",
      "enum": [
        "informational",
        "external_write",
        "shell",
        "credential_access",
        "file_mutation",
        "unknown"
      ]
    },
    "classification_authority": {"type": "string", "const": "supervisor_server_derived"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id"],
      "properties": {
        "resource_type": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1}
      }
    },
    "requested_worker_id": {"type": "string", "minLength": 1},
    "normalized_summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "request_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "received_at": {"type": "string", "format": "date-time"}
  }
}
