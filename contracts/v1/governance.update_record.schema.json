{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/governance.update_record.schema.json",
  "title": "Governance Update Record Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "update_record_id",
    "update_type",
    "target_refs",
    "source_ref",
    "version_ref",
    "hash_ref",
    "signature_verification",
    "staged_rollout",
    "approval",
    "rollback",
    "attestation_status",
    "policy_refs",
    "status",
    "producer",
    "policy_version",
    "guardian_decision_id",
    "evidence_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "governance.update_record"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "update_record_id": {
      "type": "string",
      "minLength": 1
    },
    "update_type": {
      "type": "string",
      "enum": [
        "policy_bundle",
        "worker_runtime",
        "model_bundle",
        "config"
      ]
    },
    "target_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "version_ref": {
      "type": "string",
      "minLength": 1
    },
    "hash_ref": {
      "type": "string",
      "minLength": 1
    },
    "signature_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "verification_status",
        "signer_ref",
        "trust_root_ref"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "not_selected",
            "pending",
            "verified_placeholder",
            "failed",
            "blocked"
          ]
        },
        "signer_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust_root_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "staged_rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "canary_required",
        "automatic_update_enabled",
        "pause_on_failure"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "manual_review",
            "staged_planned",
            "blocked"
          ]
        },
        "canary_required": {
          "type": "boolean"
        },
        "automatic_update_enabled": {
          "type": "boolean"
        },
        "pause_on_failure": {
          "type": "boolean"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_required",
        "approval_request_id",
        "approval_result_id",
        "approver_identity_ref"
      ],
      "properties": {
        "approval_required": {
          "type": "boolean"
        },
        "approval_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_result_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approver_identity_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_available",
        "known_good_ref",
        "rollback_required",
        "rollback_reason",
        "rollback_evidence_ref"
      ],
      "properties": {
        "rollback_available": {
          "type": "boolean"
        },
        "known_good_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollback_required": {
          "type": "boolean"
        },
        "rollback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollback_evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification_reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollback_reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "attestation_status": {
      "type": "string",
      "enum": [
        "not_required_phase0",
        "manual_review_only",
        "pending",
        "verified_placeholder",
        "failed"
      ]
    },
    "worker_attestation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "update_rollback_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_required",
        "approved_placeholder",
        "rollback_required",
        "blocked",
        "completed_mock"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "operator_console",
            "supervisor",
            "field_it_reviewer",
            "security_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "signature_verification": {
          "properties": {
            "required": {
              "const": true
            }
          }
        },
        "staged_rollout": {
          "properties": {
            "automatic_update_enabled": {
              "const": false
            },
            "pause_on_failure": {
              "const": true
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rollback_required"
          }
        }
      },
      "then": {
        "properties": {
          "rollback": {
            "properties": {
              "rollback_required": {
                "const": true
              },
              "rollback_reason": {
                "type": "string",
                "minLength": 1
              },
              "rollback_evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "rollback_reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocked_reason"
        ],
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signature_verification": {
            "properties": {
              "verification_status": {
                "const": "verified_placeholder"
              }
            },
            "required": [
              "verification_status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "signature_verification": {
            "properties": {
              "signer_ref": {
                "type": "string",
                "minLength": 1
              },
              "trust_root_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signature_verification": {
            "properties": {
              "verification_status": {
                "const": "failed"
              }
            },
            "required": [
              "verification_status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "rollback_required",
              "blocked"
            ]
          },
          "verification_reason_codes": {
            "minItems": 1
          }
        },
        "required": [
          "verification_reason_codes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "attestation_status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "rollback_required",
              "blocked"
            ]
          },
          "worker_attestation_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "worker_attestation_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved_placeholder",
              "completed_mock"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "signature_verification": {
            "properties": {
              "verification_status": {
                "const": "verified_placeholder"
              },
              "signer_ref": {
                "type": "string",
                "minLength": 1
              },
              "trust_root_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "approval_required": {
                "const": true
              }
            },
            "required": [
              "approval_required"
            ]
          },
          "status": {
            "enum": [
              "approved_placeholder",
              "completed_mock"
            ]
          }
        },
        "required": [
          "approval",
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approval_request_id": {
                "type": "string",
                "minLength": 1
              },
              "approval_result_id": {
                "type": "string",
                "minLength": 1
              },
              "approver_identity_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
