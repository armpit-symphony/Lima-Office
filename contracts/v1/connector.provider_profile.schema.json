{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/connector.provider_profile.schema.json",
  "title": "Connector Provider Profile Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "provider_profile_id",
    "connector_type",
    "provider_ref",
    "provider_status",
    "risk_level",
    "data_classes",
    "outbound_capabilities",
    "object_authorization_status",
    "property_authorization_status",
    "token_sensitivity",
    "revocation_method_status",
    "disable_switch_status",
    "rate_limit_status",
    "prompt_injection_exposure",
    "export_delete_impact_status",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "connector.provider_profile"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "security_reviewer",
            "operator_console",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_type": {
      "type": "string",
      "enum": [
        "email",
        "calendar",
        "file_storage",
        "ticketing",
        "crm",
        "chat",
        "phone_text",
        "browser",
        "rmm_it",
        "cloud_provider",
        "payment",
        "legal_regulated"
      ]
    },
    "provider_ref": {
      "type": "string",
      "minLength": 1
    },
    "provider_status": {
      "type": "string",
      "enum": [
        "profiled",
        "review_required",
        "approved_for_lab",
        "disabled",
        "revoked",
        "blocked_mvp"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "blocked_mvp"
      ]
    },
    "data_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "customer_confidential",
          "sensitive_hr",
          "sensitive_finance",
          "sensitive_legal",
          "sensitive_medical",
          "secret"
        ]
      },
      "uniqueItems": true
    },
    "outbound_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "none",
          "metadata_read",
          "draft_create",
          "draft_update",
          "external_send",
          "form_submit",
          "record_mutation"
        ]
      },
      "uniqueItems": true
    },
    "object_authorization_status": {
      "type": "string",
      "enum": [
        "required",
        "mapped",
        "missing",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "property_authorization_status": {
      "type": "string",
      "enum": [
        "required",
        "mapped",
        "missing",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "token_sensitivity": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical",
        "blocked_mvp"
      ]
    },
    "revocation_method_status": {
      "type": "string",
      "enum": [
        "documented",
        "verified_placeholder",
        "missing",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "disable_switch_status": {
      "type": "string",
      "enum": [
        "documented",
        "verified_placeholder",
        "missing",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "rate_limit_status": {
      "type": "string",
      "enum": [
        "documented",
        "missing",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "prompt_injection_exposure": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "blocked_mvp"
      ]
    },
    "export_delete_impact_status": {
      "type": "string",
      "enum": [
        "mapped",
        "review_required",
        "unknown",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider_status": {
            "const": "approved_for_lab"
          }
        },
        "required": [
          "provider_status"
        ]
      },
      "then": {
        "properties": {
          "revocation_method_status": {
            "enum": [
              "documented",
              "verified_placeholder"
            ]
          },
          "disable_switch_status": {
            "enum": [
              "documented",
              "verified_placeholder"
            ]
          },
          "evidence_refs": {
            "minItems": 1
          },
          "policy_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "enum": [
              "high",
              "critical"
            ]
          }
        },
        "required": [
          "risk_level"
        ]
      },
      "then": {
        "properties": {
          "provider_status": {
            "enum": [
              "review_required",
              "approved_for_lab",
              "blocked_mvp",
              "disabled",
              "revoked"
            ]
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_status": {
            "const": "blocked_mvp"
          }
        },
        "required": [
          "provider_status"
        ]
      },
      "then": {
        "properties": {
          "risk_level": {
            "const": "blocked_mvp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_status": {
            "enum": [
              "revoked",
              "disabled"
            ]
          }
        },
        "required": [
          "provider_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revocation_method_status": {
            "enum": [
              "missing",
              "failed_closed"
            ]
          }
        },
        "required": [
          "revocation_method_status"
        ]
      },
      "then": {
        "properties": {
          "provider_status": {
            "enum": [
              "review_required",
              "disabled",
              "revoked",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disable_switch_status": {
            "enum": [
              "missing",
              "failed_closed"
            ]
          }
        },
        "required": [
          "disable_switch_status"
        ]
      },
      "then": {
        "properties": {
          "provider_status": {
            "enum": [
              "review_required",
              "disabled",
              "revoked",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "blocked_mvp"
          }
        },
        "required": [
          "risk_level"
        ]
      },
      "then": {
        "properties": {
          "provider_status": {
            "const": "blocked_mvp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "connector_type": {
            "enum": [
              "browser",
              "rmm_it",
              "payment",
              "legal_regulated"
            ]
          }
        },
        "required": [
          "connector_type"
        ]
      },
      "then": {
        "properties": {
          "provider_status": {
            "enum": [
              "review_required",
              "disabled",
              "revoked",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "provider_status": {
            "not": {
              "const": "approved_for_lab"
            }
          }
        }
      }
    },
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "api_key"
            ]
          },
          {
            "required": [
              "oauth_token"
            ]
          },
          {
            "required": [
              "refresh_token"
            ]
          },
          {
            "required": [
              "access_token"
            ]
          },
          {
            "required": [
              "private_key"
            ]
          },
          {
            "required": [
              "password"
            ]
          }
        ]
      }
    }
  ]
}
