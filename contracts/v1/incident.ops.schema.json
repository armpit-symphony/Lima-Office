{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/incident.ops.schema.json",
  "title": "Incident Operations Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "incident_id",
    "incident_type",
    "severity",
    "severity_rubric",
    "status",
    "producer",
    "detected_by",
    "first_detected_at",
    "detected_signal",
    "customer_impact",
    "affected_subjects",
    "affected_scope",
    "containment_actions",
    "containment_started_at",
    "containment_completed_at",
    "handoff_mode",
    "remediation_authorized",
    "post_review_required",
    "runbook_ref",
    "data_classification",
    "risk_tier",
    "policy_version",
    "guardian_decision_id",
    "approval_required",
    "approval_request_id",
    "approval_token_id",
    "evidence_artifact_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "incident.ops"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "prompt_injection",
        "unauthorized_outbound_message",
        "unauthorized_file_mutation",
        "cross_tenant_memory_attempt",
        "stolen_api_key_suspected",
        "rogue_worker",
        "rogue_helper_agent",
        "lima_it_remediation_misuse",
        "connector_scope_violation",
        "evidence_writer_failure",
        "worker_offline",
        "model_tool_misuse",
        "update_verification_failure",
        "customer_network_anomaly"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "severity_rubric": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "security_review",
        "field_it_review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "triaged",
        "contained",
        "quarantined",
        "escalated",
        "resolved",
        "post_review_needed",
        "closed"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "guardian",
            "worker",
            "helper_agent",
            "operator_console",
            "lima_it_bridge"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "detected_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "detection_method"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "operator",
            "supervisor",
            "guardian",
            "worker",
            "helper_agent",
            "lima_it"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "detection_method": {
          "type": "string",
          "enum": [
            "policy_denial",
            "heartbeat_anomaly",
            "operator_report",
            "evidence_mismatch",
            "scope_mismatch",
            "manual_review"
          ]
        }
      }
    },
    "affected_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_type",
          "subject_id"
        ],
        "properties": {
          "subject_type": {
            "type": "string",
            "enum": [
              "worker",
              "helper_agent",
              "connector",
              "task",
              "memory_namespace",
              "lima_it_handoff"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "first_detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "detected_signal": {
      "type": "string",
      "enum": [
        "policy_denial",
        "heartbeat_anomaly",
        "operator_report",
        "evidence_mismatch",
        "scope_mismatch",
        "manual_review"
      ]
    },
    "customer_impact": {
      "type": "string",
      "enum": [
        "none_detected",
        "potential",
        "confirmed",
        "unknown"
      ]
    },
    "affected_scope": {
      "type": "string",
      "enum": [
        "single_task",
        "single_worker",
        "connector",
        "memory_namespace",
        "tenant_context",
        "unknown"
      ]
    },
    "containment_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "status"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "quarantine_worker",
              "revoke_worker",
              "disable_connector",
              "block_task",
              "rotate_secret_reference",
              "notify_operator",
              "create_lima_it_handoff",
              "none"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "applied",
              "failed",
              "not_required"
            ]
          }
        }
      }
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "containment_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "containment_completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "handoff_mode": {
      "type": "string",
      "enum": [
        "none",
        "diagnostic_read_only",
        "helpdesk_triage",
        "remediation_request"
      ]
    },
    "remediation_authorized": {
      "type": "boolean",
      "const": false,
      "description": "Phase 0 incident records may describe remediation requests or denial metadata, but they never authorize remediation execution."
    },
    "post_review_required": {
      "type": "boolean"
    },
    "runbook_ref": {
      "type": "string",
      "minLength": 1
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_token_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lima_it_handoff_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operator_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "handoff_mode": {
            "const": "remediation_request"
          }
        }
      },
      "then": {
        "properties": {
          "remediation_authorized": {
            "const": false
          },
          "post_review_required": {
            "const": true
          },
          "approval_token_id": {
            "const": null
          }
        }
      }
    }
  ]
}
