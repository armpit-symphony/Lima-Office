{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/guardian.decision.schema.json",
  "title": "Guardian Decision Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "decision_id",
    "request_id",
    "producer",
    "requested_by",
    "subject",
    "action_class",
    "resource_ref",
    "data_classification",
    "risk_tier",
    "policy_refs",
    "policy_version",
    "policy_snapshot_hash",
    "valid_for_action_ref",
    "decision",
    "approval_required",
    "approval_request_id",
    "approval_token_id",
    "denial_reason",
    "redaction_level",
    "evidence_required",
    "evidence_artifact_id",
    "evidence_artifact_ids",
    "prompt_injection",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "guardian.decision"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "const": "guardian"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "operator",
            "supervisor",
            "worker",
            "helper_agent",
            "connector"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id"
      ],
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "task",
            "worker",
            "helper_agent",
            "tool",
            "connector",
            "model_route",
            "memory_access",
            "lima_it_handoff"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action_class": {
      "type": "string",
      "enum": [
        "model_route",
        "tool_invocation",
        "file_read",
        "file_write",
        "file_delete",
        "network_access",
        "connector_access",
        "outbound_message",
        "scheduled_action",
        "privileged_operation",
        "memory_access",
        "worker_lifecycle",
        "lima_it_diagnostic",
        "lima_it_remediation"
      ]
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id",
        "resource_scope"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "enum": [
            "file",
            "folder",
            "connector",
            "model_provider_class",
            "memory_namespace",
            "worker",
            "supervisor",
            "lima_it_system",
            "draft_message",
            "unknown"
          ]
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_scope": {
          "type": "string",
          "enum": [
            "tenant_scoped",
            "task_scoped",
            "worker_scoped",
            "operator_scoped",
            "blocked_mvp"
          ]
        }
      }
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_snapshot_hash": {
      "type": "string",
      "minLength": 1
    },
    "valid_for_action_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque request/action binding reference. A decision cannot be reused for a different tenant, task, resource, action, or input set."
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "allow_with_evidence",
        "requires_approval",
        "deny",
        "block_mvp",
        "quarantine_subject"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_token_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "denial_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "redaction_level": {
      "type": "string",
      "enum": [
        "none",
        "metadata_only",
        "payload_redacted",
        "secret_redacted"
      ]
    },
    "evidence_required": {
      "type": "boolean"
    },
    "evidence_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prompt_injection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "untrusted_input_refs",
        "content_origin",
        "instruction_boundary",
        "injection_suspected",
        "injection_signals",
        "containment_action"
      ],
      "properties": {
        "untrusted_input_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "content_origin": {
          "type": "string",
          "enum": [
            "operator",
            "worker_telemetry",
            "email",
            "document",
            "browser",
            "ticket",
            "connector",
            "memory",
            "unknown"
          ]
        },
        "instruction_boundary": {
          "type": "string",
          "enum": [
            "trusted_system_instruction_only",
            "operator_instruction",
            "untrusted_content_as_data"
          ]
        },
        "injection_suspected": {
          "type": "boolean"
        },
        "injection_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ignore_prior_instructions",
              "request_secret",
              "request_unapproved_tool",
              "request_external_send",
              "encoded_instruction",
              "none"
            ]
          },
          "uniqueItems": true
        },
        "containment_action": {
          "type": "string",
          "enum": [
            "none",
            "treat_as_untrusted_data",
            "deny_action",
            "require_approval",
            "quarantine_subject"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "evidence_required": {
          "const": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "requires_approval"
          }
        }
      },
      "then": {
        "properties": {
          "approval_required": {
            "const": true
          },
          "approval_request_id": {
            "type": "string",
            "minLength": 1
          },
          "approval_token_id": {
            "const": null
          },
          "denial_reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "deny",
              "block_mvp",
              "quarantine_subject"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval_required": {
            "const": false
          },
          "approval_request_id": {
            "const": null
          },
          "approval_token_id": {
            "const": null
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "allow"
          }
        }
      },
      "then": {
        "properties": {
          "approval_required": {
            "const": false
          },
          "approval_request_id": {
            "const": null
          },
          "approval_token_id": {
            "const": null
          },
          "denial_reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_tier": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "deny",
              "block_mvp",
              "quarantine_subject"
            ]
          },
          "approval_token_id": {
            "const": null
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prompt_injection": {
            "properties": {
              "injection_suspected": {
                "const": true
              }
            },
            "required": [
              "injection_suspected"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "requires_approval",
              "deny",
              "block_mvp",
              "quarantine_subject"
            ]
          }
        }
      }
    }
  ]
}
