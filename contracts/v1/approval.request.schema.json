{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/approval.request.schema.json",
  "title": "Approval Request Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "approval_request_id",
    "task_id",
    "guardian_decision_id",
    "producer",
    "requested_by",
    "action_class",
    "risk_tier",
    "data_classification",
    "requested_scope",
    "scope_hash",
    "reason",
    "status",
    "approval_result",
    "approver_roles",
    "policy_version",
    "evidence_required",
    "evidence_artifact_ids",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "approval.request"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "approval_request_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "guardian",
            "operator_console"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "operator",
            "supervisor",
            "worker",
            "helper_agent"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action_class": {
      "type": "string",
      "enum": [
        "external_message_send",
        "form_submit",
        "file_delete",
        "file_overwrite",
        "customer_record_update",
        "software_install_update",
        "remediation",
        "sensitive_data_access",
        "production_server_touch",
        "regulated_system_use",
        "synthetic_form_preparation_review"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "medium",
        "high",
        "blocked"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret",
        "synthetic_fixture_only"
      ]
    },
    "requested_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_effect",
        "resource_refs",
        "allowed_operations",
        "prohibited_operations",
        "max_uses"
      ],
      "properties": {
        "external_effect": {
          "type": "string",
          "enum": [
            "send_external_message",
            "submit_form",
            "delete_file",
            "overwrite_file",
            "modify_customer_record",
            "install_update_software",
            "run_remediation",
            "access_sensitive_data",
            "touch_production_server",
            "use_regulated_system",
            "none"
          ]
        },
        "resource_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "max_uses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "scope_hash": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque digest of the requested tenant/task/action/resource scope. This is not secret material."
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "pending_review",
        "approved",
        "denied",
        "expired",
        "cancelled",
        "superseded"
      ]
    },
    "approval_result": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "cancelled",
        "superseded"
      ]
    },
    "approver_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "operator",
          "approver",
          "supervisor_admin",
          "field_it_reviewer",
          "security_reviewer",
          "business_owner"
        ]
      },
      "uniqueItems": true
    },
    "evidence_required": {
      "type": "boolean"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approver_operator_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "denial_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_token_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_chain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_action_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_tool_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "resource_refs",
        "allowed_operations",
        "prohibited_operations"
      ],
      "properties": {
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "bound_worker_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_requester_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_approval_preview_id": {"type": "string", "minLength": 1},
    "source_approval_preview_revision": {"type": "integer", "minimum": 1},
    "source_approval_preview_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operator_session_binding_id": {"type": "string", "minLength": 1},
    "fresh_intent_evidence_ref": {"type": "string", "minLength": 1},
    "approval_result_created": {"type": "boolean"},
    "approval_binding_created": {"type": "boolean"},
    "token_verification_performed": {"type": "boolean"},
    "replay_record_created": {"type": "boolean"},
    "assigned_worker_id": {"type": ["string", "null"]},
    "arc_dispatch_allowed": {"type": "boolean"},
    "arc_dispatched": {"type": "boolean"},
    "external_side_effects": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"action_class": {"const": "synthetic_form_preparation_review"}}, "required": ["action_class"]},
      "then": {
        "required": [
          "source_approval_preview_id", "source_approval_preview_revision",
          "source_approval_preview_hash", "operator_session_binding_id",
          "fresh_intent_evidence_ref", "approval_result_created",
          "approval_binding_created", "token_verification_performed",
          "replay_record_created", "assigned_worker_id", "arc_dispatch_allowed",
          "arc_dispatched", "external_side_effects"
        ],
        "properties": {
          "environment": {"const": "phase0_lab"},
          "risk_tier": {"const": "medium"},
          "data_classification": {"const": "synthetic_fixture_only"},
          "status": {"enum": ["pending_review", "denied", "expired", "cancelled"]},
          "approval_result": {"enum": ["pending", "denied", "expired", "cancelled"]},
          "approval_token_id": {"const": null},
          "approval_chain_id": {"const": null},
          "binding_id": {"const": null},
          "bound_worker_id": {"const": null},
          "assigned_worker_id": {"const": null},
          "approval_result_created": {"type": "boolean"},
          "approval_binding_created": {"const": false},
          "token_verification_performed": {"const": false},
          "replay_record_created": {"const": false},
          "arc_dispatch_allowed": {"const": false},
          "arc_dispatched": {"const": false},
          "external_side_effects": {"const": false},
          "requested_scope": {"properties": {
            "external_effect": {"const": "none"},
            "allowed_operations": {"const": ["review_prepared_form_plan"]},
            "max_uses": {"const": 0}
          }}
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_class": {"const": "synthetic_form_preparation_review"},
          "status": {"const": "pending_review"}
        },
        "required": ["action_class", "status"]
      },
      "then": {"properties": {
        "approval_result": {"const": "pending"},
        "approver_operator_id": {"const": null},
        "decided_at": {"const": null},
        "denial_reason": {"const": null},
        "approval_result_created": {"const": false}
      }}
    },
    {
      "if": {
        "properties": {
          "action_class": {"const": "synthetic_form_preparation_review"},
          "status": {"enum": ["denied", "expired", "cancelled"]}
        },
        "required": ["action_class", "status"]
      },
      "then": {
        "required": ["decided_at"],
        "properties": {
          "approval_result_created": {"const": true},
          "approval_token_id": {"const": null},
          "approval_chain_id": {"const": null},
          "binding_id": {"const": null},
          "bound_worker_id": {"const": null},
          "assigned_worker_id": {"const": null},
          "approval_binding_created": {"const": false},
          "token_verification_performed": {"const": false},
          "replay_record_created": {"const": false},
          "arc_dispatch_allowed": {"const": false},
          "arc_dispatched": {"const": false},
          "external_side_effects": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"action_class": {"const": "synthetic_form_preparation_review"}, "status": {"const": "denied"}}, "required": ["action_class", "status"]},
      "then": {"properties": {"approval_result": {"const": "denied"}, "approver_operator_id": {"type": "string", "minLength": 1}, "denial_reason": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"action_class": {"const": "synthetic_form_preparation_review"}, "status": {"const": "cancelled"}}, "required": ["action_class", "status"]},
      "then": {"properties": {"approval_result": {"const": "cancelled"}, "approver_operator_id": {"type": "string", "minLength": 1}, "denial_reason": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"action_class": {"const": "synthetic_form_preparation_review"}, "status": {"const": "expired"}}, "required": ["action_class", "status"]},
      "then": {"properties": {"approval_result": {"const": "expired"}, "approver_operator_id": {"const": null}, "denial_reason": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"action_class": {"not": {"const": "synthetic_form_preparation_review"}}}, "required": ["action_class"]},
      "then": {"properties": {"requested_scope": {"properties": {"max_uses": {"const": 1}}}}}
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "requested",
              "pending_review"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval_result": {
            "const": "pending"
          },
          "approver_operator_id": {
            "const": null
          },
          "decided_at": {
            "const": null
          },
          "denial_reason": {
            "const": null
          },
          "approval_token_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "approver_operator_id",
          "decided_at",
          "approval_token_id"
        ],
        "properties": {
          "approval_result": {
            "const": "approved"
          },
          "approver_operator_id": {
            "type": "string",
            "minLength": 1
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "denial_reason": {
            "const": null
          },
          "approval_token_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "denied"
          }
        }
      },
      "then": {
        "required": [
          "decided_at",
          "denial_reason"
        ],
        "properties": {
          "approval_result": {
            "const": "denied"
          },
          "approver_operator_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          },
          "approval_token_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "expired"
          }
        }
      },
      "then": {
        "required": [
          "decided_at"
        ],
        "properties": {
          "approval_result": {
            "const": "expired"
          },
          "approval_token_id": {
            "const": null
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "required": [
          "decided_at"
        ],
        "properties": {
          "approval_result": {
            "const": "cancelled"
          },
          "approval_token_id": {
            "const": null
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "required": [
          "decided_at"
        ],
        "properties": {
          "approval_result": {
            "const": "superseded"
          },
          "approval_token_id": {
            "const": null
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_tier": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "denied"
          },
          "approval_result": {
            "const": "denied"
          },
          "approval_token_id": {
            "const": null
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_class": {
            "enum": [
              "software_install_update",
              "remediation",
              "production_server_touch",
              "regulated_system_use"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "denied"
          },
          "approval_result": {
            "const": "denied"
          },
          "risk_tier": {
            "const": "blocked"
          },
          "approval_token_id": {
            "const": null
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
