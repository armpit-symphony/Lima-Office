{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/supervisor.conversation.turn.schema.json",
  "title": "Supervisor Conversation Turn Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name", "contract_version", "schema_version", "taxonomy_version",
    "tenant_id", "customer_context_id", "environment", "correlation_id",
    "causation_id", "idempotency_key", "producer", "policy_version",
    "turn_id", "request_id", "status", "message_sha256", "message_length",
    "data_classification", "attended", "operator_confirmation",
    "model_route_id", "guardian_decision_id", "pre_action_evidence_ref",
    "post_action_evidence_ref", "provider", "model_name", "sandbox_mode",
    "session_persistence", "tools_enabled", "web_search_enabled",
    "user_config_loaded", "rules_loaded", "tool_event_count",
    "credentials_exposed", "external_side_effects", "response_text",
    "response_sha256", "response_length", "created_at", "completed_at"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "supervisor.conversation.turn"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "taxonomy_version": {"type": "string", "const": "taxonomy-reason-v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "produced_at"],
      "properties": {
        "component": {"type": "string", "const": "supervisor"},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy_version": {"type": "string", "const": "policy-supervisor-conversation-lab-v1"},
    "turn_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "completed"},
    "message_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "message_length": {"type": "integer", "minimum": 1, "maximum": 2000},
    "data_classification": {"type": "string", "enum": ["public", "internal"]},
    "attended": {"type": "boolean", "const": true},
    "operator_confirmation": {"type": "boolean", "const": true},
    "model_route_id": {"type": "string", "minLength": 1},
    "guardian_decision_id": {"type": "string", "minLength": 1},
    "pre_action_evidence_ref": {"type": "string", "minLength": 1},
    "post_action_evidence_ref": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "const": "openai_codex_subscription"},
    "model_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "sandbox_mode": {"type": "string", "const": "read_only"},
    "session_persistence": {"type": "string", "const": "ephemeral"},
    "tools_enabled": {"type": "boolean", "const": false},
    "web_search_enabled": {"type": "boolean", "const": false},
    "user_config_loaded": {"type": "boolean", "const": false},
    "rules_loaded": {"type": "boolean", "const": false},
    "tool_event_count": {"type": "integer", "const": 0},
    "credentials_exposed": {"type": "boolean", "const": false},
    "external_side_effects": {"type": "boolean", "const": false},
    "response_text": {"type": "string", "minLength": 1, "maxLength": 8000},
    "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "response_length": {"type": "integer", "minimum": 1, "maximum": 8000},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
