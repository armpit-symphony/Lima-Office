{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/approval.chain.schema.json",
  "title": "Approval Chain Example Bundle Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "approval_chain_id",
    "chain_status",
    "expected_runtime_result",
    "approval_binding_ref",
    "records",
    "blocked_work",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "approval.chain"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "guardian",
            "operator_console"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "approval_chain_id": {
      "type": "string",
      "minLength": 1
    },
    "chain_status": {
      "type": "string",
      "enum": [
        "valid_one_time",
        "denied_blocked_mvp",
        "expired_token_denied",
        "revoked_token_denied",
        "scope_mismatch_denied",
        "tenant_mismatch_denied",
        "replay_denied",
        "lima_it_remediation_blocked",
        "tainted_input_denied"
      ]
    },
    "expected_runtime_result": {
      "type": "string",
      "enum": [
        "allow_mock_once",
        "deny_fail_closed",
        "blocked_mvp"
      ]
    },
    "approval_binding_ref": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_name",
          "record_id",
          "schema_ref",
          "summary"
        ],
        "properties": {
          "contract_name": {
            "type": "string",
            "enum": [
              "approval.request",
              "approval.result",
              "approval.token",
              "token.verification",
              "guardian.decision",
              "task.execution",
              "tool.invocation",
              "evidence.artifact",
              "taint.ref",
              "approval.binding"
            ]
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blocked_work": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "live_connector",
          "external_send",
          "oauth_provider_wiring",
          "model_provider_call",
          "browser_automation",
          "real_remediation",
          "production_operation",
          "database_or_queue"
        ]
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev-[A-Za-z0-9._:-]+$"
      },
      "uniqueItems": true
    },
    "reconciliation_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "reconciled",
        "missing_ref",
        "mismatched_binding",
        "stale_decision",
        "replay_mismatch",
        "evidence_missing",
        "coordinator_mismatch",
        "cross_tenant_blocked",
        "blocked_mvp",
        null
      ]
    },
    "reconciliation_failure_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reconciliation_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[A-Za-z0-9._:-]+$"
      },
      "uniqueItems": true
    },
    "canonical_approval_chain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_approval_binding_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_guardian_decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_token_verification_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_replay_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_transaction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chain_status": {
            "const": "valid_one_time"
          }
        }
      },
      "then": {
        "properties": {
          "expected_runtime_result": {
            "const": "allow_mock_once"
          },
          "environment": {
            "enum": [
              "mock",
              "dry_run"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chain_status": {
            "enum": [
              "denied_blocked_mvp",
              "lima_it_remediation_blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected_runtime_result": {
            "const": "blocked_mvp"
          },
          "environment": {
            "const": "blocked_mvp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chain_status": {
            "enum": [
              "expired_token_denied",
              "revoked_token_denied",
              "scope_mismatch_denied",
              "tenant_mismatch_denied",
              "replay_denied",
              "tainted_input_denied"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected_runtime_result": {
            "const": "deny_fail_closed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliation_status": {
            "const": "reconciled"
          }
        },
        "required": [
          "reconciliation_status"
        ]
      },
      "then": {
        "properties": {
          "reconciliation_failure_reasons": {
            "maxItems": 0
          },
          "reconciliation_evidence_refs": {
            "minItems": 1
          },
          "canonical_approval_chain_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_approval_binding_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_guardian_decision_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_token_verification_id": {
            "type": "string",
            "minLength": 1
          },
          "records": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "contract_name": {
                      "const": "approval.binding"
                    }
                  },
                  "required": [
                    "contract_name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "contract_name": {
                      "const": "token.verification"
                    }
                  },
                  "required": [
                    "contract_name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "contract_name": {
                      "const": "guardian.decision"
                    }
                  },
                  "required": [
                    "contract_name"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliation_status": {
            "enum": [
              "missing_ref",
              "mismatched_binding",
              "stale_decision",
              "replay_mismatch",
              "evidence_missing",
              "coordinator_mismatch",
              "cross_tenant_blocked",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "reconciliation_status"
        ]
      },
      "then": {
        "properties": {
          "reconciliation_failure_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliation_status": {
            "enum": [
              "cross_tenant_blocked",
              "blocked_mvp",
              "stale_decision"
            ]
          }
        },
        "required": [
          "reconciliation_status"
        ]
      },
      "then": {
        "properties": {
          "expected_runtime_result": {
            "not": {
              "const": "allow_mock_once"
            }
          }
        }
      }
    }
  ]
}
