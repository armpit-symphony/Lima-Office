{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/guardian.evaluation.request.schema.json",
  "title": "Guardian Evaluation Request Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "request_id",
    "actor_id",
    "actor_role",
    "action",
    "resource",
    "worker_id",
    "server_derived_category",
    "classification_authority",
    "request_hash",
    "payload_hash",
    "evidence_refs",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "guardian.evaluation.request"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "const": "taxonomy-recon-v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "const": "supervisor"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "operator",
        "supervisor",
        "field_it",
        "security_reviewer"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "safe_read",
        "status",
        "external_write",
        "shell",
        "credential_access",
        "file_mutation",
        "unknown"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "server_derived_category": {
      "type": "string",
      "enum": [
        "informational",
        "external_write",
        "shell",
        "credential_access",
        "file_mutation",
        "unknown"
      ]
    },
    "classification_authority": {
      "type": "string",
      "const": "supervisor_server_derived"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
