{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/connector.ownership.schema.json",
  "title": "Connector Ownership Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "connector_ownership_id",
    "connector_id",
    "provider_profile_id",
    "connector_readiness_id",
    "owner_refs",
    "reviewer_refs",
    "approver_refs",
    "escalation_refs",
    "ownership_status",
    "source_of_truth_status",
    "separation_of_duties_status",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "updated_at",
    "reviewed_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "connector.ownership"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "operator_console",
            "security_reviewer",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "connector_ownership_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_readiness_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approver_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "escalation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ownership_status": {
      "type": "string",
      "enum": [
        "proposed",
        "assigned",
        "active",
        "stale",
        "transferred",
        "revoked",
        "blocked_mvp",
        "failed_closed"
      ]
    },
    "source_of_truth_status": {
      "type": "string",
      "enum": [
        "declared",
        "verified_placeholder",
        "stale",
        "missing",
        "conflicted",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "separation_of_duties_status": {
      "type": "string",
      "enum": [
        "satisfied",
        "review_required",
        "violated",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ownership_status": {
            "const": "active"
          }
        },
        "required": [
          "ownership_status"
        ]
      },
      "then": {
        "properties": {
          "owner_refs": {
            "minItems": 1
          },
          "reviewer_refs": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "source_of_truth_status": {
            "enum": [
              "declared",
              "verified_placeholder"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ownership_status": {
            "enum": [
              "stale",
              "transferred",
              "revoked",
              "failed_closed"
            ]
          }
        },
        "required": [
          "ownership_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_of_truth_status": {
            "enum": [
              "stale",
              "missing",
              "conflicted",
              "failed_closed"
            ]
          }
        },
        "required": [
          "source_of_truth_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "separation_of_duties_status": {
            "const": "violated"
          }
        },
        "required": [
          "separation_of_duties_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ownership_status": {
            "const": "blocked_mvp"
          }
        },
        "required": [
          "ownership_status"
        ]
      },
      "then": {
        "properties": {
          "source_of_truth_status": {
            "enum": [
              "blocked_mvp",
              "failed_closed"
            ]
          },
          "reason_codes": {
            "contains": {
              "const": "connector_acceptance_blocked_mvp"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "ownership_status": {
            "not": {
              "const": "active"
            }
          }
        }
      }
    }
  ]
}
