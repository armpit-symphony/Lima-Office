{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/operator.session.binding.schema.json",
  "title": "Attended Local Operator Session Binding Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name", "contract_version", "schema_version", "tenant_id", "customer_context_id",
    "environment", "correlation_id", "causation_id", "idempotency_key", "producer",
    "policy_version", "binding_id", "operator_id", "auth_method", "assurance_level", "status",
    "local_loopback_only", "process_bound", "survives_process_restart", "raw_os_username_stored",
    "credentials_collected", "pin_required", "mfa_verified", "production_identity_verified",
    "pending_request_creation_allowed", "approval_authority", "approval_result_allowed",
    "approval_token_allowed", "arc_dispatch_allowed", "guardian_decision_id",
    "pre_action_evidence_ref", "post_action_evidence_ref", "issued_at", "expires_at"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "operator.session.binding"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "null"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {"type": "object", "additionalProperties": false, "required": ["component", "produced_at"], "properties": {
      "component": {"type": "string", "const": "operator_console"},
      "produced_at": {"type": "string", "format": "date-time"}
    }},
    "policy_version": {"type": "string", "const": "policy-operator-session-binding-lab-v1"},
    "binding_id": {"type": "string", "pattern": "^operator-session-binding:[0-9a-f]{32}$"},
    "operator_id": {"type": "string", "pattern": "^operator-lab:[0-9a-f]{24}$"},
    "auth_method": {"type": "string", "const": "local_os_session_attended_lab"},
    "assurance_level": {"type": "string", "const": "personal_pc_attended_lab"},
    "status": {"type": "string", "const": "active"},
    "local_loopback_only": {"type": "boolean", "const": true},
    "process_bound": {"type": "boolean", "const": true},
    "survives_process_restart": {"type": "boolean", "const": false},
    "raw_os_username_stored": {"type": "boolean", "const": false},
    "credentials_collected": {"type": "boolean", "const": false},
    "pin_required": {"type": "boolean", "const": false},
    "mfa_verified": {"type": "boolean", "const": false},
    "production_identity_verified": {"type": "boolean", "const": false},
    "pending_request_creation_allowed": {"type": "boolean", "const": true},
    "approval_authority": {"type": "boolean", "const": false},
    "approval_result_allowed": {"type": "boolean", "const": false},
    "approval_token_allowed": {"type": "boolean", "const": false},
    "arc_dispatch_allowed": {"type": "boolean", "const": false},
    "guardian_decision_id": {"type": "string", "minLength": 1},
    "pre_action_evidence_ref": {"type": "string", "minLength": 1},
    "post_action_evidence_ref": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
