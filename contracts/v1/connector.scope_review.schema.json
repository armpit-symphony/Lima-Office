{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/connector.scope_review.schema.json",
  "title": "Connector Scope Review Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "scope_review_id",
    "connector_id",
    "provider_profile_ref",
    "requested_scopes",
    "approved_scopes",
    "denied_scopes",
    "data_classes",
    "least_privilege_status",
    "object_authorization_status",
    "property_authorization_status",
    "reviewer_ref",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "reviewed_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "connector.scope_review"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "security_reviewer",
            "operator_console",
            "supervisor"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "scope_review_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approved_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "denied_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "data_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "customer_confidential",
          "sensitive_hr",
          "sensitive_finance",
          "sensitive_legal",
          "sensitive_medical",
          "secret"
        ]
      },
      "uniqueItems": true
    },
    "least_privilege_status": {
      "type": "string",
      "enum": [
        "satisfied",
        "overbroad",
        "review_required",
        "denied",
        "blocked_mvp"
      ]
    },
    "object_authorization_status": {
      "type": "string",
      "enum": [
        "required",
        "mapped",
        "missing",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "property_authorization_status": {
      "type": "string",
      "enum": [
        "required",
        "mapped",
        "missing",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "reviewer_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "least_privilege_status": {
            "const": "satisfied"
          }
        },
        "required": [
          "least_privilege_status"
        ]
      },
      "then": {
        "properties": {
          "reviewer_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "object_authorization_status": {
            "const": "mapped"
          },
          "property_authorization_status": {
            "const": "mapped"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "least_privilege_status": {
            "enum": [
              "overbroad",
              "denied",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "least_privilege_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "reviewer_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "object_authorization_status": {
            "enum": [
              "missing",
              "failed_closed"
            ]
          }
        },
        "required": [
          "object_authorization_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "connector_object_auth_missing"
            }
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "property_authorization_status": {
            "enum": [
              "missing",
              "failed_closed"
            ]
          }
        },
        "required": [
          "property_authorization_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "connector_property_auth_missing"
            }
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "least_privilege_status": {
            "const": "overbroad"
          }
        },
        "required": [
          "least_privilege_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "connector_scope_overbroad"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "least_privilege_status": {
            "const": "denied"
          }
        },
        "required": [
          "least_privilege_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "connector_scope_denied"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "least_privilege_status": {
            "not": {
              "const": "satisfied"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "const": "deprecated"
          },
          "deprecated_reason_code_policy": {
            "enum": [
              "fail_closed",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "reason_code_status",
          "deprecated_reason_code_policy"
        ]
      },
      "then": {
        "properties": {
          "least_privilege_status": {
            "not": {
              "const": "satisfied"
            }
          }
        }
      }
    }
  ]
}
