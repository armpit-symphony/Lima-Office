{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/connector.reconciliation_slo.schema.json",
  "title": "Connector Reconciliation SLO Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "reconciliation_slo_id",
    "connector_id",
    "provider_profile_id",
    "connector_readiness_id",
    "reconciliation_id",
    "owner_ref",
    "cadence_status",
    "cadence_seconds_placeholder",
    "last_reconciled_at",
    "next_due_at",
    "revocation_propagation_status",
    "disable_switch_verification_status",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "connector.reconciliation_slo"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "security_reviewer",
            "operator_console"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_slo_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_readiness_id": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "cadence_status": {
      "type": "string",
      "enum": [
        "planned",
        "current",
        "stale",
        "missed",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "cadence_seconds_placeholder": {
      "type": "integer",
      "minimum": 1
    },
    "last_reconciled_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_propagation_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "propagated",
        "missed",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "disable_switch_verification_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "verified_placeholder",
        "missed",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "acceptance_score_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reconciliation_slo_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "connector_ownership_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "connector_defaults_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "connector_slo_target_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "score_threshold_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "defaults_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "slo_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "scoring_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "connector_escalation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ownership_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "proposed",
        "assigned",
        "active",
        "stale",
        "transferred",
        "revoked",
        "blocked_mvp",
        "failed_closed",
        null
      ]
    },
    "source_of_truth_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "declared",
        "verified_placeholder",
        "stale",
        "missing",
        "conflicted",
        "failed_closed",
        "blocked_mvp",
        null
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cadence_status": {
            "enum": [
              "stale",
              "missed",
              "failed_closed"
            ]
          }
        },
        "required": [
          "cadence_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revocation_propagation_status": {
            "enum": [
              "propagated",
              "failed_closed"
            ]
          }
        },
        "required": [
          "revocation_propagation_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disable_switch_verification_status": {
            "enum": [
              "verified_placeholder",
              "failed_closed"
            ]
          }
        },
        "required": [
          "disable_switch_verification_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cadence_status": {
            "const": "blocked_mvp"
          }
        },
        "required": [
          "cadence_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "connector_acceptance_blocked_mvp"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "cadence_status": {
            "not": {
              "const": "current"
            }
          }
        }
      }
    }
  ]
}
