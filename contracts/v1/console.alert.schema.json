        "warning",
        "high",
        "blocked"
      ]
    },
    "related_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]+:[A-Za-z0-9._:-]+$"
      },
      "uniqueItems": true
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
