      "type": [
        "string",
        "null"
      ]
    },
    "score_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "blocked_mvp",
        "not_ready",
        "review_required",
        "approved_for_lab",
        "degraded",
        "revoked",
        "failed_closed",
