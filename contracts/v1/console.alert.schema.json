{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/console.alert.schema.json",
  "title": "Console Alert Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "alert_id",
    "actor_ref",
    "role",
    "alert_type",
    "severity",
    "related_contract_refs",
    "policy_refs",
    "risk_tier",
    "status",
    "runbook_ref",
    "producer",
    "policy_version",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "console.alert"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "owner_operator",
        "approver",
        "field_it",
        "auditor_readonly",
        "worker_owner",
        "security_reviewer"
      ]
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "worker_stale",
        "worker_quarantined",
        "worker_revoked",
        "evidence_missing",
        "evidence_writer_degraded",
        "guardian_denied",
        "approval_expired",
        "approval_revoked",
        "token_mismatch",
        "tainted_input",
        "connector_revoked",
        "attestation_failed",
        "update_rollback_required",
        "lima_it_remediation_blocked",
        "retention_policy_missing",
        "export_delete_policy_missing",
        "idp_mfa_missing"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "blocked"
      ]
    },
    "related_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "review_required",
        "blocked",
        "resolved_mock"
      ]
    },
    "runbook_ref": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "operator_console",
            "supervisor",
            "guardian"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocked_reason"
        ],
        "properties": {
          "risk_tier": {
            "const": "blocked"
          },
          "status": {
            "enum": [
              "active",
              "blocked",
              "review_required"
            ]
          },
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
