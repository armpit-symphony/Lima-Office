{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/connector.score_threshold.schema.json",
  "title": "Connector Score Threshold Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "score_threshold_id",
    "scoring_version",
    "provider_category",
    "approved_for_lab_min_score_placeholder",
    "review_required_min_score_placeholder",
    "degraded_max_failed_dimensions_placeholder",
    "blocked_mvp_categories",
    "required_dimensions",
    "threshold_status",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "connector.score_threshold"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "operator_console",
            "security_reviewer",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "score_threshold_id": {
      "type": "string",
      "minLength": 1
    },
    "scoring_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_category": {
      "type": "string",
      "enum": [
        "email",
        "calendar",
        "file_storage",
        "ticketing",
        "crm",
        "chat",
        "phone_text",
        "browser",
        "rmm_it",
        "cloud_provider",
        "payment",
        "legal_regulated",
        "blocked_mvp"
      ]
    },
    "approved_for_lab_min_score_placeholder": {
      "type": "number",
      "minimum": 0
    },
    "review_required_min_score_placeholder": {
      "type": "number",
      "minimum": 0
    },
    "degraded_max_failed_dimensions_placeholder": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_mvp_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "browser",
          "rmm_it",
          "cloud_provider",
          "payment",
          "legal_regulated",
          "blocked_mvp"
        ]
      },
      "uniqueItems": true
    },
    "required_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "threshold_status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved_placeholder",
        "active_placeholder",
        "stale",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "connector_defaults_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "connector_slo_target_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "threshold_status": {
            "const": "active_placeholder"
          }
        },
        "required": [
          "threshold_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "threshold_status": {
            "enum": [
              "stale",
              "failed_closed"
            ]
          }
        },
        "required": [
          "threshold_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "threshold_status": {
            "const": "blocked_mvp"
          }
        },
        "required": [
          "threshold_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "connector_threshold_blocked_mvp"
            }
          },
          "blocked_mvp_categories": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "threshold_status": {
            "not": {
              "enum": [
                "active_placeholder",
                "approved_placeholder"
              ]
            }
          }
        }
      }
    }
  ]
}
