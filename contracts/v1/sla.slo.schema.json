{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/sla.slo.schema.json",
  "title": "SLA SLO Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "measurement_id",
    "producer",
    "service_level_type",
    "lab_target",
    "contractual_sla",
    "production_commitment",
    "metric_name",
    "measurement_source",
    "target_type",
    "target_value",
    "measurement_window",
    "observed_value",
    "status",
    "breach_severity",
    "owner_role",
    "alert_route",
    "data_classification",
    "risk_tier",
    "policy_version",
    "guardian_decision_id",
    "evidence_artifact_id",
    "evidence_artifact_ids",
    "evidence_required_on_breach",
    "failure_behavior",
    "measured_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "sla.slo"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "measurement_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "guardian",
            "worker"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "service_level_type": {
      "type": "string",
      "const": "lab_slo"
    },
    "production_commitment": {
      "type": "boolean",
      "const": false
    },
    "lab_target": {
      "type": "boolean",
      "const": true
    },
    "contractual_sla": {
      "type": "boolean",
      "const": false
    },
    "metric_name": {
      "type": "string",
      "enum": [
        "supervisor_health_status",
        "worker_heartbeat_age_seconds",
        "missed_heartbeat_count",
        "task_queue_age_seconds",
        "evidence_write_success_rate",
        "guardian_decision_latency_ms",
        "approval_queue_age_seconds",
        "quarantine_count",
        "mock_connector_readiness",
        "lima_it_handoff_age_seconds"
      ]
    },
    "measurement_source": {
      "type": "string",
      "enum": [
        "supervisor_observed",
        "guardian_observed",
        "worker_reported_untrusted",
        "operator_recorded"
      ]
    },
    "target_type": {
      "type": "string",
      "enum": [
        "maximum",
        "minimum",
        "equals",
        "status_set"
      ]
    },
    "target_value": {
      "type": [
        "number",
        "string"
      ]
    },
    "measurement_window": {
      "type": "string",
      "minLength": 1
    },
    "observed_value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "within_target",
        "warning",
        "breach",
        "no_data"
      ]
    },
    "breach_severity": {
      "type": "string",
      "enum": [
        "none",
        "warning",
        "medium",
        "high"
      ]
    },
    "owner_role": {
      "type": "string",
      "enum": [
        "operator",
        "supervisor_admin",
        "field_it_reviewer",
        "security_reviewer"
      ]
    },
    "alert_route": {
      "type": "string",
      "enum": [
        "operator_dashboard",
        "field_it_review",
        "security_review"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_required_on_breach": {
      "type": "boolean"
    },
    "failure_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_warning",
        "on_breach",
        "on_no_data"
      ],
      "properties": {
        "on_warning": {
          "type": "string",
          "enum": [
            "show_operator_warning",
            "create_incident"
          ]
        },
        "on_breach": {
          "type": "string",
          "enum": [
            "create_incident",
            "quarantine_if_worker_related",
            "escalate_to_field_it"
          ]
        },
        "on_no_data": {
          "type": "string",
          "enum": [
            "show_operator_warning",
            "create_incident"
          ]
        }
      }
    },
    "measured_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
