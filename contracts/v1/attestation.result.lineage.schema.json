{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/attestation.result.lineage.schema.json",
  "title": "Attestation Result Lineage Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "lineage_id",
    "worker_id",
    "deployment_id",
    "attestation_result_id",
    "attestation_id",
    "appraisal_policy_id",
    "reference_value_refs",
    "endorsement_refs",
    "device_trust_ref",
    "worker_lifecycle_ref",
    "worker_heartbeat_ref",
    "model_route_refs",
    "update_rollback_refs",
    "transaction_refs",
    "ledger_entry_refs",
    "lineage_status",
    "revocation_propagation_status",
    "trust_effect",
    "reason_codes",
    "evidence_refs",
    "policy_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "attestation.result.lineage"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "security_reviewer",
            "field_it_reviewer",
            "operator_console"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "attestation_result_id": {
      "type": "string",
      "minLength": 1
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "appraisal_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_value_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "endorsement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "device_trust_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_lifecycle_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_heartbeat_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_route_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "update_rollback_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "transaction_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ledger_entry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lineage_status": {
      "type": "string",
      "enum": [
        "current",
        "stale",
        "revoked",
        "conflicted",
        "quarantine_required",
        "blocked_mvp"
      ]
    },
    "revocation_propagation_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "propagated",
        "failed_closed",
        "blocked_mvp"
      ]
    },
    "trust_effect": {
      "type": "string",
      "enum": [
        "trusted_metadata_only",
        "degraded",
        "quarantine_required",
        "revoked",
        "blocked_mvp"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lineage_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "revocation_propagation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "appraisal_result_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "trust_effect_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lineage_status": {
            "const": "current"
          }
        }
      },
      "then": {
        "required": [
          "attestation_result_id",
          "appraisal_policy_id",
          "reference_value_refs",
          "endorsement_refs",
          "evidence_refs",
          "expires_at"
        ],
        "properties": {
          "reference_value_refs": {
            "minItems": 1
          },
          "endorsement_refs": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage_status": {
            "const": "stale"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "attestation_lineage_stale"
            }
          },
          "evidence_refs": {
            "minItems": 1
          },
          "trust_effect": {
            "enum": [
              "degraded",
              "quarantine_required",
              "revoked",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage_status": {
            "const": "revoked"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "attestation_lineage_revoked"
            }
          },
          "evidence_refs": {
            "minItems": 1
          },
          "trust_effect": {
            "enum": [
              "revoked",
              "quarantine_required",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage_status": {
            "const": "conflicted"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "attestation_lineage_conflicted"
            }
          },
          "evidence_refs": {
            "minItems": 1
          },
          "trust_effect": {
            "enum": [
              "degraded",
              "quarantine_required",
              "revoked",
              "blocked_mvp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage_status": {
            "const": "quarantine_required"
          }
        }
      },
      "then": {
        "required": [
          "worker_lifecycle_ref"
        ],
        "properties": {
          "worker_lifecycle_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "attestation_quarantine_required"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revocation_propagation_status": {
            "const": "pending"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "revocation_propagation_pending"
            }
          },
          "trust_effect": {
            "not": {
              "const": "trusted_metadata_only"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revocation_propagation_status": {
            "const": "failed_closed"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1,
            "contains": {
              "const": "revocation_propagation_failed"
            }
          },
          "evidence_refs": {
            "minItems": 1
          },
          "trust_effect": {
            "not": {
              "const": "trusted_metadata_only"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage_status": {
            "const": "blocked_mvp"
          }
        }
      },
      "then": {
        "properties": {
          "trust_effect": {
            "not": {
              "const": "trusted_metadata_only"
            }
          }
        }
      }
    }
  ]
}
