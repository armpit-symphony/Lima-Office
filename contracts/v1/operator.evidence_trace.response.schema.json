{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/operator.evidence_trace.response.schema.json",
  "title": "Authenticated Operator Evidence Trace Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "request_id",
    "target_request_id",
    "actor_id",
    "status",
    "classification_authority",
    "worker_id",
    "guardian_decision_id",
    "lima_decision_id",
    "authorization_evidence_refs",
    "event_count",
    "events",
    "reason_codes",
    "runtime_authority_blocked",
    "executable",
    "execution_allowed",
    "side_effects_allowed"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "operator.evidence_trace.response"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "taxonomy_version": {"type": "string", "const": "taxonomy-recon-v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "produced_at"],
      "properties": {
        "component": {"type": "string", "const": "supervisor"},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy_version": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "target_request_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["available", "not_found", "denied", "unavailable"]},
    "classification_authority": {"type": "string", "const": "supervisor_server_derived"},
    "worker_id": {"type": ["string", "null"]},
    "guardian_decision_id": {"type": ["string", "null"]},
    "lima_decision_id": {"type": ["string", "null"]},
    "authorization_evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "event_count": {"type": "integer", "minimum": 0, "maximum": 128},
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "actor_id",
          "worker_id",
          "request_id",
          "decision_id",
          "guardian_decision_id",
          "parent_event_id",
          "payload_hash",
          "redacted_summary",
          "outcome",
          "reason_codes",
          "created_at",
          "runtime_authority_blocked",
          "executable",
          "execution_allowed",
          "side_effects_allowed"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "event_type": {
            "type": "string",
            "enum": [
              "request_received",
              "guardian_request",
              "guardian_decision",
              "lima_decision",
              "assignment_preview",
              "worker_acknowledgement",
              "worker_registration",
              "worker_heartbeat",
              "evidence_read",
              "denial",
              "failure",
              "approval_requested",
              "approval_expired",
              "replay_rejected"
            ]
          },
          "actor_id": {"type": "string", "minLength": 1},
          "worker_id": {"type": ["string", "null"]},
          "request_id": {"type": "string", "minLength": 1},
          "decision_id": {"type": ["string", "null"]},
          "guardian_decision_id": {"type": ["string", "null"]},
          "parent_event_id": {"type": ["string", "null"]},
          "payload_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "redacted_summary": {"type": "string", "minLength": 1, "maxLength": 240},
          "outcome": {
            "type": "string",
            "enum": ["received", "allowed_dry_run", "confirm_required", "privileged_required", "acknowledged", "rejected", "denied", "blocked", "expired", "failed_closed"]
          },
          "reason_codes": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "uniqueItems": true
          },
          "created_at": {"type": "string", "format": "date-time"},
          "runtime_authority_blocked": {"type": "boolean", "const": true},
          "executable": {"type": "boolean", "const": false},
          "execution_allowed": {"type": "boolean", "const": false},
          "side_effects_allowed": {"type": "boolean", "const": false}
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true
    },
    "runtime_authority_blocked": {"type": "boolean", "const": true},
    "executable": {"type": "boolean", "const": false},
    "execution_allowed": {"type": "boolean", "const": false},
    "side_effects_allowed": {"type": "boolean", "const": false}
  }
}
