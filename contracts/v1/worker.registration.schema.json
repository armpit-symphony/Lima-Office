{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/worker.registration.schema.json",
  "title": "Authenticated Arc Worker Registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "registration_id",
    "worker_id",
    "worker_role",
    "channel_identity_ref",
    "boot_id",
    "worker_version",
    "capabilities",
    "registration_state",
    "runtime_authority_blocked",
    "executable",
    "execution_allowed",
    "side_effects_allowed",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "worker.registration"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "const": "taxonomy-recon-v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "const": "phase0_lab"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "const": "worker"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "registration_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_role": {
      "type": "string",
      "enum": [
        "admin_arc_worker",
        "file_clerk_arc_worker",
        "it_helper_arc_worker",
        "general_office_arc_worker"
      ]
    },
    "channel_identity_ref": {
      "type": "string",
      "minLength": 1
    },
    "boot_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "document_read",
          "draft_workspace",
          "ticket_triage",
          "file_organize",
          "it_diagnostics_read_only",
          "mock_connector_readiness"
        ]
      }
    },
    "registration_state": {
      "type": "string",
      "const": "requested"
    },
    "runtime_authority_blocked": {
      "type": "boolean",
      "const": true
    },
    "executable": {
      "type": "boolean",
      "const": false
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    },
    "side_effects_allowed": {
      "type": "boolean",
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
