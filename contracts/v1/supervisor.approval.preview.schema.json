{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/supervisor.approval.preview.schema.json",
  "title": "Supervisor Tokenless Approval Preview Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name", "contract_version", "schema_version", "taxonomy_version",
    "tenant_id", "customer_context_id", "environment", "correlation_id",
    "causation_id", "idempotency_key", "producer", "policy_version",
    "approval_preview_id", "revision", "source_proposal_id",
    "source_proposal_revision", "source_proposal_state", "source_proposal_hash", "state",
    "transition_reason_codes", "review_outcome", "preview_scope",
    "approver_requirements", "future_request_policy", "guardian_decision_id",
    "pre_action_evidence_ref", "post_action_evidence_ref",
    "synthetic_data_only", "free_form_content_allowed",
    "real_approval_request_created", "approval_result_created",
    "approval_token_issued", "approval_binding_created",
    "token_verification_performed", "replay_record_created",
    "assigned_worker_id", "arc_dispatch_allowed", "arc_dispatched",
    "model_called", "tools_used", "connector_accessed", "submission_allowed",
    "external_side_effects", "preview_expires_at", "created_at", "updated_at"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "supervisor.approval.preview"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "taxonomy_version": {"type": "string", "const": "taxonomy-reason-v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "produced_at"],
      "properties": {
        "component": {"type": "string", "enum": ["supervisor", "operator_console"]},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy_version": {"type": "string", "const": "policy-supervisor-approval-preview-lab-v1"},
    "approval_preview_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "source_proposal_id": {"type": "string", "minLength": 1},
    "source_proposal_revision": {"type": "integer", "minimum": 1},
    "source_proposal_state": {"type": "string", "const": "accepted_for_future_approval"},
    "source_proposal_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"type": "string", "enum": ["preview_ready", "reviewed_no_authority", "denied", "withdrawn"]},
    "transition_reason_codes": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": ["approval_preview_created", "approval_preview_reviewed_no_authority", "approval_preview_denied", "approval_preview_withdrawn"]}
    },
    "review_outcome": {"type": "string", "enum": ["pending", "reviewed_no_authority", "denied", "withdrawn"]},
    "preview_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_action_class", "external_effect", "resource_refs", "allowed_operations", "prohibited_operations", "data_classification", "risk_tier", "scope_hash", "max_uses"],
      "properties": {
        "requested_action_class": {"type": "string", "const": "form_preparation_review"},
        "external_effect": {"type": "string", "const": "none"},
        "resource_refs": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_operations": {"type": "array", "const": ["review_prepared_form_plan"]},
        "prohibited_operations": {"type": "array", "const": ["create_real_approval_request", "issue_approval_token", "create_approval_binding", "assign_worker", "dispatch_arc", "model_call", "tool_use", "connector_access", "form_submission", "external_effect"]},
        "data_classification": {"type": "string", "const": "synthetic_fixture_only"},
        "risk_tier": {"type": "string", "const": "low"},
        "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "max_uses": {"type": "integer", "const": 0}
      }
    },
    "approver_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["approver_roles", "identity_binding_required", "identity_binding_status", "fresh_intent_required", "separation_of_duties_review_required"],
      "properties": {
        "approver_roles": {"type": "array", "const": ["business_owner"]},
        "identity_binding_required": {"type": "boolean", "const": true},
        "identity_binding_status": {"type": "string", "const": "not_bound_in_preview"},
        "fresh_intent_required": {"type": "boolean", "const": true},
        "separation_of_duties_review_required": {"type": "boolean", "const": true}
      }
    },
    "future_request_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["guardian_recheck_required", "proposal_revision_recheck_required", "single_use_token_required_if_later_approved", "suggested_request_ttl_seconds", "silent_promotion_allowed"],
      "properties": {
        "guardian_recheck_required": {"type": "boolean", "const": true},
        "proposal_revision_recheck_required": {"type": "boolean", "const": true},
        "single_use_token_required_if_later_approved": {"type": "boolean", "const": true},
        "suggested_request_ttl_seconds": {"type": "integer", "const": 900},
        "silent_promotion_allowed": {"type": "boolean", "const": false}
      }
    },
    "guardian_decision_id": {"type": "string", "minLength": 1},
    "pre_action_evidence_ref": {"type": "string", "minLength": 1},
    "post_action_evidence_ref": {"type": "string", "minLength": 1},
    "synthetic_data_only": {"type": "boolean", "const": true},
    "free_form_content_allowed": {"type": "boolean", "const": false},
    "real_approval_request_created": {"type": "boolean", "const": false},
    "approval_result_created": {"type": "boolean", "const": false},
    "approval_token_issued": {"type": "boolean", "const": false},
    "approval_binding_created": {"type": "boolean", "const": false},
    "token_verification_performed": {"type": "boolean", "const": false},
    "replay_record_created": {"type": "boolean", "const": false},
    "assigned_worker_id": {"type": "null"},
    "arc_dispatch_allowed": {"type": "boolean", "const": false},
    "arc_dispatched": {"type": "boolean", "const": false},
    "model_called": {"type": "boolean", "const": false},
    "tools_used": {"type": "boolean", "const": false},
    "connector_accessed": {"type": "boolean", "const": false},
    "submission_allowed": {"type": "boolean", "const": false},
    "external_side_effects": {"type": "boolean", "const": false},
    "preview_expires_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "preview_ready"}}}, "then": {"properties": {"review_outcome": {"const": "pending"}}}},
    {"if": {"properties": {"state": {"const": "reviewed_no_authority"}}}, "then": {"properties": {"review_outcome": {"const": "reviewed_no_authority"}}}},
    {"if": {"properties": {"state": {"const": "denied"}}}, "then": {"properties": {"review_outcome": {"const": "denied"}}}},
    {"if": {"properties": {"state": {"const": "withdrawn"}}}, "then": {"properties": {"review_outcome": {"const": "withdrawn"}}}}
  ]
}
