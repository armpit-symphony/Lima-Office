{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/approval.result.schema.json",
  "title": "Approval Result Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "approval_result_id",
    "approval_request_id",
    "task_id",
    "guardian_decision_id",
    "producer",
    "result",
    "result_reason_code",
    "approver_operator_id",
    "approver_role_ref",
    "action_class",
    "risk_tier",
    "data_classification",
    "requested_scope_hash",
    "approved_scope_hash",
    "approval_token_id",
    "blocked_mvp_action",
    "denial_reason",
    "fresh_operator_intent_ref",
    "policy_version",
    "evidence_artifact_ids",
    "decided_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "approval.result"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "approval_result_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_request_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "operator_console"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "approved",
        "denied",
        "expired",
        "cancelled",
        "superseded",
        "partial_approved"
      ]
    },
    "result_reason_code": {
      "type": "string",
      "enum": [
        "approved",
        "denied_by_approver",
        "blocked_mvp",
        "expired",
        "cancelled",
        "superseded",
        "partial_scope_requires_new_request"
      ]
    },
    "approver_operator_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approver_role_ref": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "operator",
        "approver",
        "supervisor_admin",
        "field_it_reviewer",
        "security_reviewer",
        "business_owner",
        null
      ]
    },
    "action_class": {
      "type": "string",
      "enum": [
        "external_message_send",
        "form_submit",
        "file_delete",
        "file_overwrite",
        "customer_record_update",
        "software_install_update",
        "remediation",
        "sensitive_data_access",
        "production_server_touch",
        "regulated_system_use",
        "synthetic_form_preparation_review"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "medium",
        "high",
        "blocked"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret",
        "synthetic_fixture_only"
      ]
    },
    "requested_scope_hash": {
      "type": "string",
      "minLength": 1
    },
    "approved_scope_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_token_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_chain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_use_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "one_time",
        "bounded_window",
        "blocked_mvp",
        null
      ]
    },
    "nonce_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opaque replay-protection reference. Do not store nonce secret material."
    },
    "bound_tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_action_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_tool_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "resource_refs",
        "allowed_operations",
        "prohibited_operations"
      ],
      "properties": {
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "bound_worker_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_requester_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_approver_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_mvp_action": {
      "type": "boolean"
    },
    "denial_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "fresh_operator_intent_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_kind": {
      "type": "string",
      "enum": ["attended_deny", "attended_cancel", "explicit_expire"]
    },
    "operator_session_binding_id": {"type": ["string", "null"]},
    "approval_binding_created": {"type": "boolean"},
    "token_verification_performed": {"type": "boolean"},
    "replay_record_created": {"type": "boolean"},
    "assigned_worker_id": {"type": ["string", "null"]},
    "arc_dispatch_allowed": {"type": "boolean"},
    "arc_dispatched": {"type": "boolean"},
    "external_side_effects": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"action_class": {"const": "synthetic_form_preparation_review"}},
        "required": ["action_class"]
      },
      "then": {
        "required": [
          "decision_kind", "operator_session_binding_id", "approval_binding_created",
          "token_verification_performed", "replay_record_created", "assigned_worker_id",
          "arc_dispatch_allowed", "arc_dispatched", "external_side_effects"
        ],
        "properties": {
          "environment": {"const": "phase0_lab"},
          "result": {"enum": ["denied", "expired", "cancelled"]},
          "risk_tier": {"const": "medium"},
          "data_classification": {"const": "synthetic_fixture_only"},
          "approved_scope_hash": {"const": null},
          "approval_token_id": {"const": null},
          "approval_chain_id": {"const": null},
          "binding_id": {"const": null},
          "token_use_policy": {"const": null},
          "nonce_ref": {"const": null},
          "bound_worker_id": {"const": null},
          "blocked_mvp_action": {"const": false},
          "denial_reason": {"type": "string", "minLength": 1},
          "fresh_operator_intent_ref": {"type": "string", "minLength": 1},
          "approval_binding_created": {"const": false},
          "token_verification_performed": {"const": false},
          "replay_record_created": {"const": false},
          "assigned_worker_id": {"const": null},
          "arc_dispatch_allowed": {"const": false},
          "arc_dispatched": {"const": false},
          "external_side_effects": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"action_class": {"const": "synthetic_form_preparation_review"}, "result": {"const": "denied"}}, "required": ["action_class", "result"]},
      "then": {"properties": {"result_reason_code": {"const": "denied_by_approver"}, "decision_kind": {"const": "attended_deny"}, "approver_operator_id": {"type": "string", "minLength": 1}, "approver_role_ref": {"const": "business_owner"}, "operator_session_binding_id": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"action_class": {"const": "synthetic_form_preparation_review"}, "result": {"const": "cancelled"}}, "required": ["action_class", "result"]},
      "then": {"properties": {"result_reason_code": {"const": "cancelled"}, "decision_kind": {"const": "attended_cancel"}, "approver_operator_id": {"type": "string", "minLength": 1}, "approver_role_ref": {"const": "business_owner"}, "operator_session_binding_id": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"action_class": {"const": "synthetic_form_preparation_review"}, "result": {"const": "expired"}}, "required": ["action_class", "result"]},
      "then": {"properties": {"result_reason_code": {"const": "expired"}, "decision_kind": {"const": "explicit_expire"}, "approver_operator_id": {"const": null}, "approver_role_ref": {"const": null}, "operator_session_binding_id": {"const": null}}}
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "result_reason_code": {
            "const": "approved"
          },
          "approver_operator_id": {
            "type": "string",
            "minLength": 1
          },
          "approver_role_ref": {
            "type": "string",
            "minLength": 1
          },
          "approved_scope_hash": {
            "type": "string",
            "minLength": 1
          },
          "approval_token_id": {
            "type": "string",
            "minLength": 1
          },
          "blocked_mvp_action": {
            "const": false
          },
          "denial_reason": {
            "const": null
          },
          "fresh_operator_intent_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "denied"
          }
        }
      },
      "then": {
        "properties": {
          "approval_token_id": {
            "const": null
          },
          "approved_scope_hash": {
            "const": null
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "blocked_mvp_action": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "denied"
          },
          "result_reason_code": {
            "const": "blocked_mvp"
          },
          "risk_tier": {
            "const": "blocked"
          },
          "approval_token_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_class": {
            "enum": [
              "software_install_update",
              "remediation",
              "production_server_touch",
              "regulated_system_use"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "denied"
          },
          "result_reason_code": {
            "const": "blocked_mvp"
          },
          "risk_tier": {
            "const": "blocked"
          },
          "approval_token_id": {
            "const": null
          },
          "blocked_mvp_action": {
            "const": true
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "partial_approved"
          }
        }
      },
      "then": {
        "properties": {
          "result_reason_code": {
            "const": "partial_scope_requires_new_request"
          },
          "approval_token_id": {
            "const": null
          },
          "approved_scope_hash": {
            "type": "string",
            "minLength": 1
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
