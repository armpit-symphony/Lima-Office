{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/evidence.artifact.schema.json",
  "title": "Evidence Artifact Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "artifact_id",
    "artifact_type",
    "producer",
    "actor",
    "subject",
    "action_class",
    "risk_tier",
    "data_classification",
    "guardian_decision_id",
    "approval_request_id",
    "approval_token_id",
    "replay_record_id",
    "replay_artifact_id",
    "denial_evidence_ref",
    "pre_action_evidence_refs",
    "post_action_evidence_refs",
    "export_manifest_refs",
    "redaction_profile_ref",
    "hash_algorithm",
    "content_hash",
    "parent_evidence_refs",
    "chain_position",
    "raw_content_included",
    "secret_material_included",
    "policy_version",
    "policy_snapshot_hash",
    "redaction_status",
    "redaction_profile",
    "redacted_fields",
    "retention_class",
    "retention_policy_ref",
    "retention_expires_at",
    "delete_eligible",
    "storage_ref",
    "payload_hash",
    "integrity_ref",
    "previous_artifact_id",
    "access_control_ref",
    "export_eligible",
    "export_redaction_profile",
    "summary",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "evidence.artifact"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "guardian_decision",
        "approval_request",
        "approval_token",
        "worker_lifecycle",
        "worker_heartbeat",
        "task_transition",
        "tool_invocation",
        "model_route",
        "memory_access",
        "connector_trust",
        "incident",
        "lima_it_handoff",
        "slo_measurement",
        "denial",
        "quarantine",
        "evidence_failure"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "worker",
            "guardian",
            "operator_console",
            "helper_agent",
            "lima_it_bridge"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "operator",
            "supervisor",
            "worker",
            "helper_agent",
            "guardian"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id"
      ],
      "properties": {
        "subject_type": {
          "type": "string",
          "enum": [
            "task",
            "worker",
            "helper_agent",
            "connector",
            "memory_access",
            "tool_invocation",
            "model_route",
            "incident",
            "lima_it_handoff",
            "evidence_failure"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action_class": {
      "type": "string",
      "enum": [
        "model_route",
        "tool_invocation",
        "file_read",
        "file_write",
        "file_delete",
        "network_access",
        "connector_access",
        "outbound_message",
        "scheduled_action",
        "privileged_operation",
        "memory_access",
        "worker_lifecycle",
        "lima_it_diagnostic",
        "lima_it_remediation",
        "slo_measurement",
        "evidence_failure"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret"
      ]
    },
    "guardian_decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_chain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_token_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_verification_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "replay_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_transaction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_coordinator_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_replay_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_ledger_entry_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_evidence_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[A-Za-z0-9._:-]+$"
      },
      "uniqueItems": true
    },
    "related_export_manifest_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "linkage_status": {
      "type": "string",
      "enum": [
        "linked",
        "missing_ref",
        "mismatched_tenant",
        "mismatched_scope",
        "mismatched_nonce",
        "drift_detected",
        "blocked_mvp"
      ]
    },
    "linkage_failure_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "canonical_tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "canonical_decision_nonce": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_action_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_tool_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "resource_refs",
        "allowed_operations",
        "prohibited_operations"
      ],
      "properties": {
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "canonical_worker_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "replay_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "denial_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "pre_action_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "post_action_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "export_manifest_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "redaction_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "enum": [
        "sha256",
        "sha512"
      ]
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "parent_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "chain_position": {
      "type": "integer",
      "minimum": 1
    },
    "raw_content_included": {
      "type": "boolean",
      "const": false
    },
    "secret_material_included": {
      "type": "boolean",
      "const": false
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_snapshot_hash": {
      "type": "string",
      "minLength": 1
    },
    "redaction_status": {
      "type": "string",
      "enum": [
        "none",
        "metadata_only",
        "payload_redacted",
        "secret_redacted"
      ]
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "transient_task",
        "short_term_operator_review",
        "evidence_retained",
        "customer_exit_pending",
        "deletion_pending"
      ]
    },
    "redaction_profile": {
      "type": "string",
      "enum": [
        "none",
        "metadata_only",
        "operator_safe_summary",
        "secret_safe"
      ]
    },
    "redacted_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retention_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "retention_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "delete_eligible": {
      "type": "boolean"
    },
    "storage_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_ref",
        "contains_sensitive_payload",
        "secret_material_present"
      ],
      "properties": {
        "location_ref": {
          "type": "string",
          "minLength": 1
        },
        "contains_sensitive_payload": {
          "type": "boolean"
        },
        "secret_material_present": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "integrity_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "minLength": 1
    },
    "previous_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_control_ref": {
      "type": "string",
      "minLength": 1
    },
    "export_eligible": {
      "type": "boolean"
    },
    "export_redaction_profile": {
      "type": "string",
      "enum": [
        "not_exportable",
        "metadata_only",
        "operator_safe_summary",
        "customer_safe_summary"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_classification": {
            "enum": [
              "sensitive_hr",
              "sensitive_finance",
              "sensitive_legal",
              "sensitive_medical",
              "secret"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "redaction_status": {
            "enum": [
              "payload_redacted",
              "secret_redacted"
            ]
          },
          "redaction_profile": {
            "enum": [
              "operator_safe_summary",
              "secret_safe"
            ]
          },
          "export_redaction_profile": {
            "enum": [
              "not_exportable",
              "metadata_only",
              "customer_safe_summary"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_classification": {
            "const": "secret"
          }
        }
      },
      "then": {
        "properties": {
          "redaction_status": {
            "const": "secret_redacted"
          },
          "export_eligible": {
            "const": false
          },
          "export_redaction_profile": {
            "const": "not_exportable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage_ref": {
            "properties": {
              "contains_sensitive_payload": {
                "const": true
              }
            },
            "required": [
              "contains_sensitive_payload"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "redaction_status": {
            "not": {
              "const": "none"
            }
          },
          "redacted_fields": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "evidence_failure"
          }
        }
      },
      "then": {
        "properties": {
          "action_class": {
            "const": "evidence_failure"
          },
          "risk_tier": {
            "enum": [
              "high",
              "blocked"
            ]
          },
          "export_eligible": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "denial"
          }
        }
      },
      "then": {
        "properties": {
          "denial_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "pre_action_evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chain_position": {
            "minimum": 2
          }
        },
        "required": [
          "chain_position"
        ]
      },
      "then": {
        "properties": {
          "parent_evidence_refs": {
            "minItems": 1
          },
          "previous_artifact_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "export_eligible": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "redaction_profile_ref": {
            "type": "string",
            "minLength": 1
          },
          "retention_policy_ref": {
            "type": "string",
            "minLength": 1
          },
          "raw_content_included": {
            "const": false
          },
          "secret_material_included": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "linkage_status": {
            "const": "linked"
          }
        },
        "required": [
          "linkage_status"
        ]
      },
      "then": {
        "properties": {
          "linkage_failure_reasons": {
            "maxItems": 0
          },
          "related_ledger_entry_ids": {
            "minItems": 1
          },
          "related_evidence_artifact_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "linkage_status": {
            "enum": [
              "missing_ref",
              "mismatched_tenant",
              "mismatched_scope",
              "mismatched_nonce",
              "drift_detected",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "linkage_status"
        ]
      },
      "then": {
        "properties": {
          "linkage_failure_reasons": {
            "minItems": 1
          },
          "risk_tier": {
            "enum": [
              "high",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "linkage_status": {
            "const": "mismatched_tenant"
          }
        },
        "required": [
          "linkage_status"
        ]
      },
      "then": {
        "properties": {
          "export_eligible": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "replay_record_id": {
            "type": "string"
          }
        },
        "required": [
          "replay_record_id"
        ]
      },
      "then": {
        "properties": {
          "related_replay_record_ids": {
            "minItems": 1
          },
          "related_ledger_entry_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "export_manifest_refs": {
            "minItems": 1
          }
        },
        "required": [
          "export_manifest_refs"
        ]
      },
      "then": {
        "properties": {
          "related_export_manifest_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
