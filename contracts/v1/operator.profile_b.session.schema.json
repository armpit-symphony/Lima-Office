{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/operator.profile_b.session.schema.json",
  "title": "Profile B Operator Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name", "contract_version", "schema_version", "tenant_id", "customer_context_id",
    "environment", "correlation_id", "causation_id", "idempotency_key", "producer", "policy_version",
    "binding_id", "operator_id", "auth_method", "assurance_level", "status", "owner_display_name",
    "named_owner", "device_bound", "device_binding_ref", "credential_id_hash", "local_loopback_only",
    "process_bound", "survives_process_restart", "survives_restart", "raw_os_username_stored",
    "credentials_collected", "pin_required", "mfa_verified", "production_identity_verified",
    "customer_or_production_use_allowed", "approval_authority", "approval_result_allowed",
    "approval_token_allowed", "arc_dispatch_allowed", "positive_approval_step_up", "step_up_issued",
    "step_up_ttl_seconds", "session_ttl_seconds", "runtime_authority_blocked",
    "operator_authentication_manifest", "guardian_decision_id", "pre_action_evidence_ref",
    "post_action_evidence_ref", "issued_at", "expires_at"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "operator.profile_b.session"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "null"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {"type": "object", "additionalProperties": false, "required": ["component", "produced_at"], "properties": {
      "component": {"type": "string", "const": "operator_console"},
      "produced_at": {"type": "string", "format": "date-time"}
    }},
    "policy_version": {"type": "string", "const": "policy-operator-profile-b-session-lab-v1"},
    "binding_id": {"type": "string", "pattern": "^operator-profile-b-session:[0-9a-f]{32}$"},
    "operator_id": {"type": "string", "pattern": "^operator-profile-b:[0-9a-f]{24}$"},
    "auth_method": {"type": "string", "enum": ["lab_hmac_ceremony", "webauthn_platform"]},
    "assurance_level": {"type": "string", "enum": ["profile_b_lab_ceremony", "profile_b_platform_webauthn"]},
    "status": {"type": "string", "const": "active"},
    "owner_display_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .'-]{0,79}$"},
    "named_owner": {"type": "boolean", "const": true},
    "device_bound": {"type": "boolean", "const": true},
    "device_binding_ref": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "credential_id_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "local_loopback_only": {"type": "boolean", "const": true},
    "process_bound": {"type": "boolean", "const": true},
    "survives_process_restart": {"type": "boolean", "const": false},
    "survives_restart": {"type": "boolean", "const": false},
    "raw_os_username_stored": {"type": "boolean", "const": false},
    "credentials_collected": {"type": "boolean", "const": false},
    "pin_required": {"type": "boolean", "const": false},
    "mfa_verified": {"type": "boolean", "const": true},
    "production_identity_verified": {"type": "boolean", "const": false},
    "customer_or_production_use_allowed": {"type": "boolean", "const": false},
    "approval_authority": {"type": "boolean", "const": false},
    "approval_result_allowed": {"type": "boolean", "const": false},
    "approval_token_allowed": {"type": "boolean", "const": false},
    "arc_dispatch_allowed": {"type": "boolean", "const": false},
    "positive_approval_step_up": {"type": "string", "const": "stub_only"},
    "step_up_issued": {"type": "boolean", "const": false},
    "step_up_ttl_seconds": {"type": "integer", "const": 300},
    "session_ttl_seconds": {"type": "integer", "const": 1800},
    "runtime_authority_blocked": {"type": "boolean", "const": true},
    "operator_authentication_manifest": {
      "type": "boolean",
      "const": true,
      "description": "Lab capability claim only. approval_authority stays false, positive_approval_step_up stays stub_only, arc_dispatch_allowed stays false, and survives_restart stays false. The display name is not directory identity. Hello proves local user verification only. Attestation format is none. The signature counter may stay zero. The credential is process memory only."
    },
    "guardian_decision_id": {"type": "string", "minLength": 1},
    "pre_action_evidence_ref": {"type": "string", "minLength": 1},
    "post_action_evidence_ref": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"auth_method": {"const": "lab_hmac_ceremony"}}, "required": ["auth_method"]}, "then": {"properties": {"assurance_level": {"const": "profile_b_lab_ceremony"}}}},
    {"if": {"properties": {"auth_method": {"const": "webauthn_platform"}}, "required": ["auth_method"]}, "then": {"properties": {"assurance_level": {"const": "profile_b_platform_webauthn"}}}}
  ]
}
