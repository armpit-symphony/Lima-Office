{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/replay.store.record.schema.json",
  "title": "Replay Store Record Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "replay_record_id",
    "decision_nonce",
    "guardian_decision_id",
    "approval_binding_id",
    "approval_token_id",
    "token_verification_id",
    "action_type",
    "tool_scope",
    "nonce_status",
    "atomicity_status",
    "consumed_at",
    "checked_at",
    "evidence_refs",
    "failure_reason",
    "created_at",
    "raw_content_included",
    "secret_material_included"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "replay.store.record"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "guardian",
            "supervisor"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "replay_record_id": {
      "type": "string",
      "minLength": 1
    },
    "replay_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_nonce": {
      "type": "string",
      "minLength": 1
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_binding_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_token_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_verification_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "tool_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "resource_refs",
        "allowed_operations",
        "prohibited_operations"
      ],
      "properties": {
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "nonce_status": {
      "type": "string",
      "enum": [
        "reserved",
        "consumed",
        "replay_denied",
        "expired",
        "revoked",
        "failed"
      ]
    },
    "atomicity_status": {
      "type": "string",
      "enum": [
        "pending",
        "committed",
        "rolled_back",
        "failed_closed"
      ]
    },
    "consumed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "denial_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash_algorithm": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "sha256",
        "sha512",
        null
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "parent_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "chain_position": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "export_manifest_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_content_included": {
      "type": "boolean",
      "const": false
    },
    "secret_material_included": {
      "type": "boolean",
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nonce_status": {
            "const": "consumed"
          }
        },
        "required": [
          "nonce_status"
        ]
      },
      "then": {
        "properties": {
          "consumed_at": {
            "type": "string",
            "format": "date-time"
          },
          "atomicity_status": {
            "const": "committed"
          },
          "failure_reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nonce_status": {
            "const": "reserved"
          }
        },
        "required": [
          "nonce_status"
        ]
      },
      "then": {
        "properties": {
          "consumed_at": {
            "const": null
          },
          "failure_reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nonce_status": {
            "const": "replay_denied"
          }
        },
        "required": [
          "nonce_status"
        ]
      },
      "then": {
        "properties": {
          "denial_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "consumed_at": {
            "const": null
          },
          "atomicity_status": {
            "enum": [
              "committed",
              "failed_closed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nonce_status": {
            "enum": [
              "expired",
              "revoked",
              "failed"
            ]
          }
        },
        "required": [
          "nonce_status"
        ]
      },
      "then": {
        "properties": {
          "failure_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "atomicity_status": {
            "const": "failed_closed"
          }
        },
        "required": [
          "atomicity_status"
        ]
      },
      "then": {
        "properties": {
          "failure_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "atomicity_status": {
            "const": "rolled_back"
          }
        },
        "required": [
          "atomicity_status"
        ]
      },
      "then": {
        "properties": {
          "failure_reason": {
            "type": "string",
            "minLength": 1
          },
          "consumed_at": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "replay_artifact_id": {
            "type": "string"
          }
        },
        "required": [
          "replay_artifact_id"
        ]
      },
      "then": {
        "properties": {
          "hash_algorithm": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "minLength": 1
          },
          "chain_position": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}
