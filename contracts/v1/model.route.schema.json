{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/model.route.schema.json",
  "title": "Model Route Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "model_route_id",
    "task_id",
    "producer",
    "requested_by",
    "route_state",
    "data_classification",
    "prompt_sensitivity",
    "risk_tier",
    "model_capability_required",
    "allowed_provider_classes",
    "provider_class",
    "selected_provider_class",
    "routing_policy_ref",
    "data_residency_preference",
    "data_egress_allowed",
    "cloud_allowed",
    "fallback_allowed",
    "prompt_ref",
    "response_ref",
    "redaction_required",
    "policy_version",
    "guardian_decision_id",
    "approval_required",
    "approval_token_id",
    "evidence_artifact_id",
    "evidence_artifact_ids",
    "prompt_injection",
    "failure_behavior",
    "created_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "model.route"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "model_route_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "worker",
            "helper_agent",
            "guardian"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "supervisor",
            "worker",
            "helper_agent"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "route_state": {
      "type": "string",
      "enum": [
        "requested",
        "allowed",
        "routed",
        "denied",
        "failed",
        "fallback_required"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "customer_confidential",
        "sensitive_hr",
        "sensitive_finance",
        "sensitive_legal",
        "sensitive_medical",
        "secret"
      ]
    },
    "prompt_sensitivity": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "secret_material_blocked"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "model_capability_required": {
      "type": "string",
      "enum": [
        "general_reasoning",
        "document_summary",
        "classification",
        "draft_generation",
        "it_triage",
        "vision",
        "coding"
      ]
    },
    "allowed_provider_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "local_model",
          "subscription_cloud_model"
        ]
      },
      "uniqueItems": true
    },
    "provider_class": {
      "type": "string",
      "enum": [
        "local",
        "subscription",
        "cloud",
        "unavailable"
      ]
    },
    "selected_provider_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "local_model",
        "subscription_cloud_model",
        null
      ]
    },
    "routing_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "data_residency_preference": {
      "type": "string",
      "enum": [
        "local_only",
        "local_preferred",
        "cloud_allowed_if_policy_allows"
      ]
    },
    "data_egress_allowed": {
      "type": "boolean"
    },
    "cloud_allowed": {
      "type": "boolean"
    },
    "fallback_allowed": {
      "type": "boolean"
    },
    "prompt_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to redacted prompt/input artifact. Raw prompt text is not stored in this contract."
    },
    "response_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reference to redacted response/output artifact. Raw model output is not stored in this contract."
    },
    "redaction_required": {
      "type": "boolean"
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_token_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_verification_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "taint_ref_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "denial_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prompt_injection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "untrusted_input_refs",
        "content_origin",
        "injection_suspected",
        "injection_signals",
        "containment_action"
      ],
      "properties": {
        "untrusted_input_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "content_origin": {
          "type": "string",
          "enum": [
            "operator",
            "document",
            "email",
            "ticket",
            "browser",
            "memory",
            "connector",
            "unknown"
          ]
        },
        "injection_suspected": {
          "type": "boolean"
        },
        "injection_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "request_secret",
              "request_unapproved_tool",
              "ignore_prior_instructions",
              "none"
            ]
          },
          "uniqueItems": true
        },
        "containment_action": {
          "type": "string",
          "enum": [
            "none",
            "treat_as_untrusted_data",
            "deny_route",
            "require_approval"
          ]
        }
      }
    },
    "failure_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_provider_unavailable",
        "on_policy_denial",
        "on_evidence_failure"
      ],
      "properties": {
        "on_provider_unavailable": {
          "type": "string",
          "enum": [
            "fallback_to_local_if_allowed",
            "block_task",
            "escalate_to_operator"
          ]
        },
        "on_policy_denial": {
          "type": "string",
          "enum": [
            "block_task",
            "request_operator_review"
          ]
        },
        "on_evidence_failure": {
          "type": "string",
          "enum": [
            "block_task",
            "escalate_to_operator"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_egress_allowed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "selected_provider_class": {
            "not": {
              "const": "subscription_cloud_model"
            }
          },
          "cloud_allowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cloud_allowed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "selected_provider_class": {
            "not": {
              "const": "subscription_cloud_model"
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "prompt_sensitivity": {
                "const": "secret_material_blocked"
              }
            }
          },
          {
            "properties": {
              "data_classification": {
                "const": "secret"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "denial_reason"
        ],
        "properties": {
          "route_state": {
            "const": "denied"
          },
          "selected_provider_class": {
            "const": null
          },
          "response_ref": {
            "const": null
          },
          "redaction_required": {
            "const": true
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prompt_injection": {
            "properties": {
              "injection_suspected": {
                "const": true
              }
            },
            "required": [
              "injection_suspected"
            ]
          }
        }
      },
      "then": {
        "required": [
          "taint_ref_ids"
        ],
        "properties": {
          "route_state": {
            "enum": [
              "denied",
              "failed",
              "fallback_required"
            ]
          },
          "taint_ref_ids": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route_state": {
            "enum": [
              "denied",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "denial_reason"
        ],
        "properties": {
          "response_ref": {
            "const": null
          },
          "denial_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
