{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/evidence.failure.schema.json",
  "title": "Evidence Failure Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "evidence_failure_id",
    "producer",
    "failure_stage",
    "failure_code",
    "affected_contract",
    "affected_action_class",
    "evidence_required",
    "pre_action_blocked",
    "post_action_degraded",
    "action_blocked",
    "task_id",
    "worker_id",
    "tool_invocation_id",
    "last_successful_evidence_artifact_id",
    "failure_record_ref",
    "failure_hash_ref",
    "emergency_spool_ref",
    "spool_hash_ref",
    "retry_state",
    "reconciliation_status",
    "incident_id",
    "quarantine_required",
    "approval_tokens_revoked",
    "guardian_decision_id",
    "replay_record_id",
    "replay_artifact_id",
    "denial_evidence_ref",
    "pre_action_evidence_refs",
    "post_action_evidence_refs",
    "export_manifest_refs",
    "redaction_profile_ref",
    "hash_algorithm",
    "content_hash",
    "parent_evidence_refs",
    "chain_position",
    "raw_content_included",
    "secret_material_included",
    "failure_reason",
    "policy_version",
    "detected_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "evidence.failure"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "evidence_failure_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "supervisor",
            "guardian",
            "worker"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "failure_stage": {
      "type": "string",
      "enum": [
        "pre_action",
        "post_action",
        "reconciliation"
      ]
    },
    "failure_code": {
      "type": "string",
      "enum": [
        "ledger_unavailable",
        "integrity_check_failed",
        "permission_denied",
        "storage_full",
        "queue_exhausted",
        "unknown"
      ]
    },
    "affected_contract": {
      "type": "string",
      "minLength": 1
    },
    "affected_action_class": {
      "type": "string",
      "enum": [
        "model_route",
        "tool_invocation",
        "file_read",
        "file_write",
        "file_delete",
        "network_access",
        "connector_access",
        "outbound_message",
        "privileged_operation",
        "memory_access",
        "worker_lifecycle",
        "lima_it_diagnostic",
        "lima_it_remediation"
      ]
    },
    "evidence_required": {
      "type": "boolean",
      "const": true
    },
    "pre_action_blocked": {
      "type": "boolean"
    },
    "post_action_degraded": {
      "type": "boolean"
    },
    "action_blocked": {
      "type": "boolean"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_successful_evidence_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_record_ref": {
      "type": "string",
      "minLength": 1
    },
    "failure_hash_ref": {
      "type": "string",
      "minLength": 1
    },
    "emergency_spool_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "spool_hash_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry_state": {
      "type": "string",
      "enum": [
        "not_started",
        "queued",
        "retrying",
        "exhausted",
        "not_allowed"
      ]
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "reconciled",
        "failed"
      ]
    },
    "incident_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "quarantine_required": {
      "type": "boolean"
    },
    "approval_tokens_revoked": {
      "type": "boolean"
    },
    "guardian_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "replay_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "replay_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "denial_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "pre_action_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "post_action_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "export_manifest_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "redaction_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "enum": [
        "sha256",
        "sha512"
      ]
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "parent_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "chain_position": {
      "type": "integer",
      "minimum": 1
    },
    "raw_content_included": {
      "type": "boolean",
      "const": false
    },
    "secret_material_included": {
      "type": "boolean",
      "const": false
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "failure_stage": {
            "const": "pre_action"
          }
        }
      },
      "then": {
        "properties": {
          "pre_action_blocked": {
            "const": true
          },
          "post_action_degraded": {
            "const": false
          },
          "action_blocked": {
            "const": true
          },
          "retry_state": {
            "enum": [
              "queued",
              "retrying",
              "exhausted",
              "not_allowed"
            ]
          },
          "denial_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "pre_action_evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failure_stage": {
            "const": "post_action"
          }
        }
      },
      "then": {
        "required": [
          "emergency_spool_ref",
          "spool_hash_ref"
        ],
        "properties": {
          "pre_action_blocked": {
            "const": false
          },
          "post_action_degraded": {
            "const": true
          },
          "emergency_spool_ref": {
            "type": "string",
            "minLength": 1
          },
          "spool_hash_ref": {
            "type": "string",
            "minLength": 1
          },
          "post_action_evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failure_code": {
            "enum": [
              "integrity_check_failed",
              "queue_exhausted"
            ]
          }
        }
      },
      "then": {
        "required": [
          "incident_id"
        ],
        "properties": {
          "incident_id": {
            "type": "string",
            "minLength": 1
          },
          "quarantine_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failure_code": {
            "const": "ledger_unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "failure_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "replay_record_id": {
            "type": "string"
          }
        },
        "required": [
          "replay_record_id"
        ]
      },
      "then": {
        "properties": {
          "replay_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "hash_algorithm": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "minLength": 1
          },
          "chain_position": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}
