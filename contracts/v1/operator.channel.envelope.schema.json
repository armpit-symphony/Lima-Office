{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/operator.channel.envelope.schema.json",
  "title": "Authenticated Operator Channel Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "message_id",
    "actor_id",
    "message_type",
    "key_id",
    "nonce",
    "payload_hash",
    "signature_algorithm",
    "signature",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "operator.channel.envelope"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "taxonomy_version": {"type": "string", "const": "taxonomy-recon-v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "produced_at"],
      "properties": {
        "component": {"type": "string", "enum": ["operator_client", "supervisor"]},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy_version": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "message_type": {
      "type": "string",
      "enum": ["operator_request", "operator_response"]
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque reference to an injected lab operator key; never the key value."
    },
    "nonce": {"type": "string", "minLength": 16, "maxLength": 128},
    "payload_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "signature_algorithm": {"type": "string", "const": "hmac-sha256"},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
