{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/helper.assignment.schema.json",
  "title": "Office Operations Helper Assignment Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name", "contract_version", "schema_version", "taxonomy_version",
    "tenant_id", "customer_context_id", "environment", "correlation_id",
    "causation_id", "idempotency_key", "producer", "policy_version",
    "assignment_id", "request_id", "helper_scope_id", "helper_agent_id",
    "helper_role", "review_type", "scenario_id", "data_classification",
    "status", "reason_codes", "guardian_decision_id", "pre_action_evidence_ref",
    "attended", "operator_confirmation", "synthetic_data_only",
    "deterministic_review", "model_call_allowed", "tool_execution_allowed",
    "memory_access_allowed", "approval_token_access_allowed",
    "arc_dispatch_allowed", "connector_access_allowed", "submission_allowed",
    "external_side_effects", "created_at"
  ],
  "properties": {
    "contract_name": {"type": "string", "const": "helper.assignment"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "taxonomy_version": {"type": "string", "const": "taxonomy-reason-v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_context_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "const": "phase0_lab"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "produced_at"],
      "properties": {
        "component": {"type": "string", "const": "supervisor"},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy_version": {"type": "string", "minLength": 1},
    "assignment_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "helper_scope_id": {"type": "string", "minLength": 1},
    "helper_agent_id": {"type": "string", "const": "office-operations-helper-001"},
    "helper_role": {"type": "string", "const": "office_operations_helper"},
    "review_type": {"type": "string", "const": "registration_sop_review"},
    "scenario_id": {
      "type": "string",
      "enum": ["complete-contact", "missing-phone", "invalid-email", "invalid-postal-code", "consent-not-granted"]
    },
    "data_classification": {"type": "string", "const": "synthetic_fixture_only"},
    "status": {"type": "string", "const": "assigned"},
    "reason_codes": {
      "type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true
    },
    "guardian_decision_id": {"type": "string", "minLength": 1},
    "pre_action_evidence_ref": {"type": "string", "minLength": 1},
    "attended": {"type": "boolean", "const": true},
    "operator_confirmation": {"type": "boolean", "const": true},
    "synthetic_data_only": {"type": "boolean", "const": true},
    "deterministic_review": {"type": "boolean", "const": true},
    "model_call_allowed": {"type": "boolean", "const": false},
    "tool_execution_allowed": {"type": "boolean", "const": false},
    "memory_access_allowed": {"type": "boolean", "const": false},
    "approval_token_access_allowed": {"type": "boolean", "const": false},
    "arc_dispatch_allowed": {"type": "boolean", "const": false},
    "connector_access_allowed": {"type": "boolean", "const": false},
    "submission_allowed": {"type": "boolean", "const": false},
    "external_side_effects": {"type": "boolean", "const": false},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
