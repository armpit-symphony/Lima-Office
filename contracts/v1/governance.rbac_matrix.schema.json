{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/governance.rbac_matrix.schema.json",
  "title": "Governance RBAC Matrix Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "matrix_id",
    "role",
    "permissions",
    "permission_scope",
    "assurance_requirements",
    "mfa_requirement",
    "session_requirement",
    "device_trust_requirement",
    "separation_of_duties_required",
    "blocked_mvp_actions",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "governance.rbac_matrix"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "operator_console",
            "supervisor",
            "security_reviewer",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "matrix_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "sparkpit_operator",
        "customer_admin",
        "approver",
        "field_it",
        "auditor_readonly",
        "security_reviewer",
        "worker_owner",
        "arc_worker_node",
        "supervisor_service",
        "helper_agent"
      ]
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "level"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "view_supervisor_health",
              "view_worker_fleet",
              "onboard_worker",
              "quarantine_worker",
              "reenroll_worker",
              "revoke_worker",
              "view_task_queue",
              "request_approval",
              "approve_low_risk_task",
              "approve_privileged_task",
              "deny_task",
              "view_guardian_decisions",
              "view_evidence_metadata",
              "export_evidence_metadata",
              "request_customer_export",
              "request_customer_delete",
              "approve_lima_it_diagnostic",
              "approve_lima_it_remediation",
              "connector_consent_review",
              "connector_revocation",
              "update_rollback_approval",
              "breakglass_request_review"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "none",
              "view",
              "request",
              "approve",
              "deny",
              "administer",
              "blocked_mvp"
            ]
          }
        }
      },
      "uniqueItems": true
    },
    "permission_scope": {
      "type": "string",
      "enum": [
        "tenant_metadata_only",
        "tenant_action_metadata_only",
        "worker_fleet_metadata_only",
        "governance_review_only",
        "blocked_mvp"
      ]
    },
    "assurance_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_assurance",
        "authenticator_assurance",
        "federation_assurance",
        "fresh_intent_required"
      ],
      "properties": {
        "identity_assurance": {
          "type": "string",
          "enum": [
            "ial_placeholder",
            "ial1_or_equivalent",
            "ial2_or_equivalent",
            "blocked_mvp"
          ]
        },
        "authenticator_assurance": {
          "type": "string",
          "enum": [
            "aal_placeholder",
            "aal1_or_equivalent",
            "aal2_or_equivalent",
            "aal3_or_equivalent_preferred",
            "blocked_mvp"
          ]
        },
        "federation_assurance": {
          "type": "string",
          "enum": [
            "fal_placeholder",
            "fal1_or_equivalent",
            "fal2_or_equivalent",
            "fal3_or_equivalent_preferred",
            "not_applicable",
            "blocked_mvp"
          ]
        },
        "fresh_intent_required": {
          "type": "boolean"
        }
      }
    },
    "mfa_requirement": {
      "type": "string",
      "enum": [
        "no_mfa_blocked",
        "phishing_resistant_preferred",
        "step_up_required_for_privileged",
        "breakglass_requires_post_review"
      ]
    },
    "session_requirement": {
      "type": "string",
      "enum": [
        "session_ttl_placeholder",
        "idle_timeout_placeholder",
        "step_up_on_risk",
        "revoke_on_role_change",
        "revoke_on_device_untrusted"
      ]
    },
    "device_trust_requirement": {
      "type": "string",
      "enum": [
        "managed_device_placeholder",
        "attested_worker_placeholder",
        "untrusted_device_readonly_or_blocked",
        "device_posture_required_for_privileged"
      ]
    },
    "separation_of_duties_required": {
      "type": "boolean"
    },
    "blocked_mvp_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "approve_lima_it_remediation",
          "breakglass_request_review",
          "request_customer_delete",
          "request_customer_export",
          "connector_consent_review",
          "update_rollback_approval",
          "approve_privileged_task"
        ]
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "type": "object",
              "properties": {
                "action": {
                  "enum": [
                    "approve_privileged_task",
                    "approve_lima_it_remediation",
                    "update_rollback_approval",
                    "connector_consent_review"
                  ]
                },
                "level": {
                  "enum": [
                    "approve",
                    "administer"
                  ]
                }
              },
              "required": [
                "action",
                "level"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "mfa_requirement": {
            "enum": [
              "phishing_resistant_preferred",
              "step_up_required_for_privileged"
            ]
          },
          "device_trust_requirement": {
            "enum": [
              "managed_device_placeholder",
              "attested_worker_placeholder",
              "device_posture_required_for_privileged"
            ]
          },
          "session_requirement": {
            "enum": [
              "step_up_on_risk",
              "revoke_on_role_change",
              "revoke_on_device_untrusted"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "type": "object",
              "properties": {
                "action": {
                  "const": "approve_lima_it_remediation"
                },
                "level": {
                  "enum": [
                    "approve",
                    "administer"
                  ]
                }
              },
              "required": [
                "action",
                "level"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "separation_of_duties_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "type": "object",
              "properties": {
                "action": {
                  "const": "approve_lima_it_remediation"
                },
                "level": {
                  "const": "blocked_mvp"
                }
              },
              "required": [
                "action",
                "level"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "blocked_mvp_actions": {
            "contains": {
              "const": "approve_lima_it_remediation"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "type": "object",
              "properties": {
                "action": {
                  "const": "breakglass_request_review"
                }
              },
              "required": [
                "action"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "type": "object",
              "properties": {
                "action": {
                  "const": "breakglass_request_review"
                },
                "level": {
                  "const": "blocked_mvp"
                }
              },
              "required": [
                "action",
                "level"
              ]
            }
          },
          "blocked_mvp_actions": {
            "contains": {
              "const": "breakglass_request_review"
            }
          },
          "reason_codes": {
            "contains": {
              "const": "breakglass_blocked_mvp"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "auditor_readonly"
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "items": {
              "properties": {
                "level": {
                  "enum": [
                    "none",
                    "view"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device_trust_requirement": {
            "const": "untrusted_device_readonly_or_blocked"
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "items": {
              "properties": {
                "level": {
                  "enum": [
                    "none",
                    "view",
                    "blocked_mvp"
                  ]
                }
              }
            }
          },
          "reason_codes": {
            "contains": {
              "const": "device_untrusted"
            }
          }
        }
      }
    }
  ]
}
