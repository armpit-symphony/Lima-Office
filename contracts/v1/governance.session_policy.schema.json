{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/governance.session_policy.schema.json",
  "title": "Governance Session Policy Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "policy_version",
    "session_policy_id",
    "actor_type",
    "role",
    "session_ttl_seconds",
    "idle_timeout_seconds",
    "step_up_required_actions",
    "revocation_triggers",
    "device_trust_requirement",
    "mfa_requirement",
    "evidence_refs",
    "reason_codes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "governance.session_policy"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "operator_console",
            "supervisor",
            "security_reviewer",
            "compliance_reviewer"
          ]
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "session_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "sparkpit_operator",
        "customer_admin",
        "approver",
        "field_it",
        "auditor_readonly",
        "security_reviewer",
        "worker_owner",
        "arc_worker_node",
        "supervisor_service",
        "helper_agent"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "sparkpit_operator",
        "customer_admin",
        "approver",
        "field_it",
        "auditor_readonly",
        "security_reviewer",
        "worker_owner",
        "arc_worker_node",
        "supervisor_service",
        "helper_agent"
      ]
    },
    "session_ttl_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "idle_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "step_up_required_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "approve_privileged_task",
          "approve_lima_it_remediation",
          "update_rollback_approval",
          "connector_consent_review",
          "request_customer_delete"
        ]
      },
      "uniqueItems": true
    },
    "revocation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "role_changed",
          "device_untrusted",
          "manual_revoke",
          "mfa_reset",
          "session_expired",
          "suspicious_activity"
        ]
      },
      "uniqueItems": true
    },
    "device_trust_requirement": {
      "type": "string",
      "enum": [
        "managed_device_placeholder",
        "attested_worker_placeholder",
        "untrusted_device_readonly_or_blocked",
        "device_posture_required_for_privileged"
      ]
    },
    "mfa_requirement": {
      "type": "string",
      "enum": [
        "no_mfa_blocked",
        "phishing_resistant_preferred",
        "step_up_required_for_privileged",
        "breakglass_requires_post_review"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "step_up_required_actions": {
            "minItems": 1
          }
        },
        "required": [
          "step_up_required_actions"
        ]
      },
      "then": {
        "properties": {
          "mfa_requirement": {
            "const": "step_up_required_for_privileged"
          },
          "session_ttl_seconds": {
            "maximum": 43200
          },
          "idle_timeout_seconds": {
            "maximum": 3600
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revocation_triggers": {
            "contains": {
              "const": "role_changed"
            }
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "session_revoked"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revocation_triggers": {
            "contains": {
              "const": "device_untrusted"
            }
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": {
              "const": "device_untrusted"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "auditor_readonly"
          }
        }
      },
      "then": {
        "properties": {
          "step_up_required_actions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
