{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lima-office.local/contracts/v1/supervisor.health.schema.json",
  "title": "Supervisor Health Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "schema_version",
    "taxonomy_version",
    "tenant_id",
    "customer_context_id",
    "environment",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "producer",
    "supervisor_id",
    "generated_at",
    "mode",
    "worker_count",
    "worker_state_counts",
    "task_state_counts",
    "guardian_decision_counts",
    "evidence_status_counts",
    "stale_heartbeat_count",
    "quarantined_worker_count",
    "revoked_worker_count",
    "blocked_task_count",
    "denied_action_count",
    "degraded_component_count",
    "health_status",
    "reasons",
    "evidence_refs",
    "policy_refs",
    "related_contract_refs",
    "data_classification",
    "redaction_level",
    "raw_customer_content_present",
    "secret_material_present",
    "policy_version"
  ],
  "properties": {
    "contract_name": {
      "type": "string",
      "const": "supervisor.health"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "phase0_lab",
        "mock",
        "dry_run",
        "blocked_mvp"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "produced_at"
      ],
      "properties": {
        "component": {
          "type": "string",
          "const": "supervisor"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "supervisor_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "lab_planned"
      ]
    },
    "worker_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "worker_state_counts": {
      "$ref": "#/$defs/counts"
    },
    "task_state_counts": {
      "$ref": "#/$defs/counts"
    },
    "guardian_decision_counts": {
      "$ref": "#/$defs/counts"
    },
    "evidence_status_counts": {
      "$ref": "#/$defs/counts"
    },
    "stale_heartbeat_count": {
      "type": "integer",
      "minimum": 0
    },
    "quarantined_worker_count": {
      "type": "integer",
      "minimum": 0
    },
    "revoked_worker_count": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_task_count": {
      "type": "integer",
      "minimum": 0
    },
    "denied_action_count": {
      "type": "integer",
      "minimum": 0
    },
    "degraded_component_count": {
      "type": "integer",
      "minimum": 0
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "blocked",
        "unknown",
        "blocked_mvp"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "worker_stale",
          "worker_quarantined",
          "worker_revoked",
          "evidence_missing",
          "evidence_writer_degraded",
          "guardian_denied",
          "approval_expired",
          "approval_revoked",
          "token_mismatch",
          "tainted_input",
          "connector_revoked",
          "connector_consent_missing",
          "connector_scope_overbroad",
          "connector_scope_denied",
          "connector_revocation_missing",
          "connector_object_auth_missing",
          "connector_property_auth_missing",
          "connector_outbound_action_blocked",
          "connector_live_blocked_mvp",
          "connector_prompt_injection_risk",
          "connector_rate_limit_missing",
          "connector_secret_policy_missing",
          "connector_export_delete_impact_unknown",
          "connector_provider_high_risk",
          "connector_provider_critical_risk",
          "connector_disable_switch_missing",
          "connector_disable_switch_failed",
          "connector_revocation_unverified",
          "connector_revocation_drill_failed",
          "connector_token_rotation_missing",
          "connector_outbound_capability_blocked",
          "connector_prompt_injection_blocked",
          "connector_cross_tenant_blocked",
          "connector_reconciliation_drift",
          "consent_revoked_but_ready",
          "scope_overbroad_but_invocation_requested",
          "provider_critical_but_ready",
          "revocation_drill_failed_but_enabled",
          "disable_switch_missing_but_ready",
          "outbound_missing_approval",
          "tainted_connector_payload_blocked",
          "connector_cross_tenant_linkage",
          "connector_evidence_missing",
          "connector_trust_revoked_but_allowed",
          "connector_score_below_threshold",
          "connector_score_failed_closed",
          "connector_score_degraded",
          "connector_slo_missed",
          "connector_slo_stale",
          "connector_reconciliation_stale",
          "connector_revocation_propagation_pending",
          "connector_revocation_propagation_missed",
          "connector_disable_verification_missed",
          "connector_source_of_truth_missing",
          "connector_source_of_truth_conflict",
          "connector_owner_missing",
          "connector_owner_stale",
          "connector_owner_conflict",
          "connector_sod_violation",
          "connector_escalation_overdue",
          "connector_revocation_owner_missing",
          "connector_disable_owner_missing",
          "connector_accountability_failed_closed",
          "connector_acceptance_blocked_mvp",
          "attestation_failed",
          "attestation_result_expired",
          "attestation_quarantine_required",
          "attestation_reference_mismatch",
          "attestation_lineage_stale",
          "attestation_lineage_revoked",
          "attestation_lineage_conflicted",
          "attestation_result_trust_conflict",
          "attestation_reconciliation_drift",
          "attestation_revocation_pending",
          "attestation_revocation_not_propagated",
          "attestation_quarantine_mismatch",
          "attestation_cross_tenant_linkage",
          "verifier_authority_conflict",
          "appraisal_policy_revoked_but_active",
          "trusted_result_with_revoked_endorsement",
          "trusted_result_with_revoked_reference",
          "model_route_selected_with_untrusted_lineage",
          "transaction_committed_with_revoked_attestation",
          "revocation_propagation_pending",
          "revocation_propagation_failed",
          "verifier_authority_missing",
          "verifier_authority_revoked",
          "reference_authority_missing",
          "endorsement_authority_missing",
          "quarantine_clearance_sod_required",
          "reference_value_missing",
          "reference_value_stale",
          "reference_value_revoked",
          "endorsement_missing",
          "endorsement_revoked",
          "endorsement_expired",
          "appraisal_policy_missing",
          "appraisal_policy_revoked",
          "appraisal_failed",
          "appraisal_inconclusive",
          "update_rollback_required",
          "lima_it_remediation_blocked",
          "retention_policy_missing",
          "export_delete_policy_missing",
          "idp_mfa_missing",
          "task_blocked",
          "model_route_unavailable",
          "model_route_blocked_mvp",
          "model_route_tainted_input_denied",
          "model_route_privileged_requires_approval",
          "model_route_provider_blocked_mvp",
          "model_route_local_execution_blocked_mvp",
          "model_route_rbac_blocked",
          "model_route_device_untrusted",
          "model_route_fallback_denied",
          "health_unknown",
          "health_degraded",
          "health_blocked"
        ]
      },
      "uniqueItems": true
    },
    "health_domain": {
      "type": "string",
      "const": "supervisor"
    },
    "health_reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "worker_stale",
          "worker_quarantined",
          "worker_revoked",
          "evidence_missing",
          "evidence_writer_degraded",
          "guardian_denied",
          "approval_expired",
          "approval_revoked",
          "token_mismatch",
          "tainted_input",
          "connector_revoked",
          "connector_consent_missing",
          "connector_scope_overbroad",
          "connector_scope_denied",
          "connector_revocation_missing",
          "connector_object_auth_missing",
          "connector_property_auth_missing",
          "connector_outbound_action_blocked",
          "connector_live_blocked_mvp",
          "connector_prompt_injection_risk",
          "connector_rate_limit_missing",
          "connector_secret_policy_missing",
          "connector_export_delete_impact_unknown",
          "connector_provider_high_risk",
          "connector_provider_critical_risk",
          "connector_disable_switch_missing",
          "connector_disable_switch_failed",
          "connector_revocation_unverified",
          "connector_revocation_drill_failed",
          "connector_token_rotation_missing",
          "connector_outbound_capability_blocked",
          "connector_prompt_injection_blocked",
          "connector_cross_tenant_blocked",
          "connector_reconciliation_drift",
          "consent_revoked_but_ready",
          "scope_overbroad_but_invocation_requested",
          "provider_critical_but_ready",
          "revocation_drill_failed_but_enabled",
          "disable_switch_missing_but_ready",
          "outbound_missing_approval",
          "tainted_connector_payload_blocked",
          "connector_cross_tenant_linkage",
          "connector_evidence_missing",
          "connector_trust_revoked_but_allowed",
          "connector_score_below_threshold",
          "connector_score_failed_closed",
          "connector_score_degraded",
          "connector_slo_missed",
          "connector_slo_stale",
          "connector_reconciliation_stale",
          "connector_revocation_propagation_pending",
          "connector_revocation_propagation_missed",
          "connector_disable_verification_missed",
          "connector_source_of_truth_missing",
          "connector_source_of_truth_conflict",
          "connector_owner_missing",
          "connector_owner_stale",
          "connector_owner_conflict",
          "connector_sod_violation",
          "connector_escalation_overdue",
          "connector_revocation_owner_missing",
          "connector_disable_owner_missing",
          "connector_accountability_failed_closed",
          "connector_acceptance_blocked_mvp",
          "attestation_failed",
          "attestation_result_expired",
          "attestation_quarantine_required",
          "attestation_reference_mismatch",
          "attestation_lineage_stale",
          "attestation_lineage_revoked",
          "attestation_lineage_conflicted",
          "attestation_result_trust_conflict",
          "attestation_reconciliation_drift",
          "attestation_revocation_pending",
          "attestation_revocation_not_propagated",
          "attestation_quarantine_mismatch",
          "attestation_cross_tenant_linkage",
          "verifier_authority_conflict",
          "appraisal_policy_revoked_but_active",
          "trusted_result_with_revoked_endorsement",
          "trusted_result_with_revoked_reference",
          "model_route_selected_with_untrusted_lineage",
          "transaction_committed_with_revoked_attestation",
          "revocation_propagation_pending",
          "revocation_propagation_failed",
          "verifier_authority_missing",
          "verifier_authority_revoked",
          "reference_authority_missing",
          "endorsement_authority_missing",
          "quarantine_clearance_sod_required",
          "reference_value_missing",
          "reference_value_stale",
          "reference_value_revoked",
          "endorsement_missing",
          "endorsement_revoked",
          "endorsement_expired",
          "appraisal_policy_missing",
          "appraisal_policy_revoked",
          "appraisal_failed",
          "appraisal_inconclusive",
          "update_rollback_required",
          "lima_it_remediation_blocked",
          "retention_policy_missing",
          "export_delete_policy_missing",
          "idp_mfa_missing",
          "task_blocked",
          "model_route_unavailable",
          "model_route_blocked_mvp",
          "model_route_tainted_input_denied",
          "model_route_privileged_requires_approval",
          "model_route_provider_blocked_mvp",
          "model_route_local_execution_blocked_mvp",
          "model_route_rbac_blocked",
          "model_route_device_untrusted",
          "model_route_fallback_denied",
          "health_unknown",
          "health_degraded",
          "health_blocked"
        ]
      },
      "uniqueItems": true
    },
    "acceptance_score_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reconciliation_slo_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "score_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "blocked_mvp",
        "not_ready",
        "review_required",
        "approved_for_lab",
        "degraded",
        "revoked",
        "failed_closed",
        null
      ]
    },
    "cadence_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "planned",
        "current",
        "stale",
        "missed",
        "failed_closed",
        "blocked_mvp",
        null
      ]
    },
    "connector_ownership_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "connector_escalation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ownership_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "proposed",
        "assigned",
        "active",
        "stale",
        "transferred",
        "revoked",
        "blocked_mvp",
        "failed_closed",
        null
      ]
    },
    "source_of_truth_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "declared",
        "verified_placeholder",
        "stale",
        "missing",
        "conflicted",
        "failed_closed",
        "blocked_mvp",
        null
      ]
    },
    "route_health_counts": {
      "$ref": "#/$defs/counts"
    },
    "model_route_status_counts": {
      "$ref": "#/$defs/counts"
    },
    "operator_visible": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_contract_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "internal"
      ]
    },
    "redaction_level": {
      "type": "string",
      "const": "metadata_only"
    },
    "raw_customer_content_present": {
      "type": "boolean",
      "const": false
    },
    "secret_material_present": {
      "type": "boolean",
      "const": false
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason_code_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknown_reason_code_policy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "display_unknown",
        "blocked_mvp"
      ]
    },
    "deprecated_reason_code_policy": {
      "type": "string",
      "enum": [
        "allow_with_warning",
        "fail_closed",
        "blocked_mvp"
      ]
    },
    "reason_code_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown",
        "blocked"
      ]
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "health_status": {
            "const": "healthy"
          }
        }
      },
      "then": {
        "properties": {
          "stale_heartbeat_count": {
            "const": 0
          },
          "quarantined_worker_count": {
            "const": 0
          },
          "revoked_worker_count": {
            "const": 0
          },
          "blocked_task_count": {
            "const": 0
          },
          "denied_action_count": {
            "const": 0
          },
          "degraded_component_count": {
            "const": 0
          },
          "reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "health_status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "health_status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "health_reason_codes": {
            "contains": {
              "const": "health_unknown"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "health_status": {
            "const": "blocked_mvp"
          }
        }
      },
      "then": {
        "properties": {
          "health_reason_codes": {
            "contains": {
              "const": "model_route_blocked_mvp"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "health_status": {
            "const": "degraded"
          }
        }
      },
      "then": {
        "properties": {
          "degraded_component_count": {
            "minimum": 1
          },
          "reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "reason_code_status"
        ]
      },
      "then": {
        "properties": {
          "health_status": {
            "enum": [
              "degraded",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code_status": {
            "const": "deprecated"
          },
          "deprecated_reason_code_policy": {
            "enum": [
              "fail_closed",
              "blocked_mvp"
            ]
          }
        },
        "required": [
          "reason_code_status",
          "deprecated_reason_code_policy"
        ]
      },
      "then": {
        "properties": {
          "health_status": {
            "not": {
              "const": "healthy"
            }
          }
        }
      }
    }
  ]
}
